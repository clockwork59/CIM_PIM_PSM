# P0核心设备详细模型 (P0 Core Equipment Detailed Models)
# 18类P0医疗设备完整本体建模

equipment_type_models:
  # 1. 离心式冷水机组 (Centrifugal Chiller) - P0核心
  CENTRIFUGAL_CHILLER:
    equipment_id: "EQUIP_HVAC_001"
    equipment_name: "离心式冷水机组"
    equipment_family: "CHILLER_FAMILY"
    system_category: "HVAC-CHP"
    criticality_level: "CRITICAL"
    medical_grade: true

    # 设备标识和分类
    identification:
      functional_category: "MEDICAL_COOLING_SOURCE"
      equipment_role: "PRIMARY_COOLING_SOURCE"
      tag_numbering: "CH-01-XX"
      naming_convention: "CH-{Building}-{Sequence}"

    # 静态属性 (铭牌参数、安装信息)
    static_properties:
      nameplate_ratings:
        cooling_capacity: "500-2000 RT"
        input_power: "可根据容量计算"
        refrigerant_type: ["R134a", "R513A", "R1234ze"]
        voltage_supply: "380V/3Ph/50Hz"
        compressor_type: "离心式"
        efficiency_rating: "符合GB 30254-2020"

      installation_details:
        installation_location: "机房/屋面/室外"
        mounting_type: ["基础安装", "减振安装"]
        space_requirements:
          length: "4000-6000mm"
          width: "2000-3000mm"
          height: "2200-2800mm"
          service_space: "四周≥1.5m，顶部≥2m"
        weight:
          operating_weight: "8000-15000kg"
          shipping_weight: "7000-13000kg"

      topological_connections:
        upstream_interfaces: ["电网供电", "冷却水系统", "控制系统"]
        downstream_interfaces: ["冷冻水系统", "冷凝水排放", "排热系统"]
        auxiliary_connections: ["润滑系统", "控制系统", "安全系统"]

    # 动态属性 (实时状态、性能参数)
    dynamic_properties:
      operational_states:
        running_states:
          - OFF
          - STARTING_SEQUENCE
          - RUNNING
          - UNLOADING
          - STOPPING_SEQUENCE
          - MAINTENANCE_MODE
        load_conditions:
          - MIN_LOAD: "10%"
          - PARTIAL_LOAD: "25-75%"
          - DESIGN_LOAD: "100%"
          - OVERLOAD: "105%"

      performance_parameters:
        cooling_output:
          leaving_chilled_water_temp: "7±0.5°C"
          entering_condenser_water_temp: "32°C"
          refrigerant_pressure_high: "对应R134a饱和曲线"
          refrigerant_pressure_low: "对应R134a饱和曲线"
        efficiency_metrics:
          coefficient_of_performance:
            design_cop: "≥6.0"
            part_load_cop: "≥7.0 @ 50%"
          specific_power: "≤0.58 kW/RT"
        environmental_constraints:
          ambient_temp_range: "15-45°C"
          relative_humidity: "≤90%"
          altitude_limit: "≤1000m"

      measured_realtime_signals:
        primary_measurements:
          evaporator_temp_in: "°C"
          evaporator_temp_out: "°C"
          evaporator_flow_rate: "L/s"
          condenser_temp_in: "°C"
          condenser_temp_out: "°C"
          condenser_flow_rate: "L/s"
        efficiency_signals:
          compressor_power: "kW"
          total_power_consumption: "kW"
          cop_realtime: "1"
          part_load_ratio: "%"
        health_indicators:
          compressor_vibration: "mm/s"
          oil_pressure: "bar"
          motor_current: "A"
          discharge_temp: "°C"

    # 控制属性 (设定点、命令、控制模式)
    control_properties:
      setpoints:
        temperature_control:
          leaving_chilled_water_sp: "7°C"
          entering_condenser_water_sp: "32°C"
          dead_band: "±0.5°C"
        pressure_control:
          evaporator_pressure_limits: ["min: 2.5bar", "max: 6.0bar"]
          condenser_pressure_limits: ["min: 8.0bar", "max: 16.0bar"]
        safety_limits:
          motor_current_limit: "额定电流×110%"
          discharge_temp_limit: "对应制冷剂安全值"
          oil_pressure_diff: "≥0.7bar"

      control_commands:
        operational_commands:
          - START_NORMAL: "正常启动"
          - STOP_NORMAL: "正常停机"
          - EMERGENCY_STOP: "紧急停机"
          - RESET: "故障复位"
        modulation_commands:
          - LOAD_UP: "加载"
          - LOAD_DOWN: "减载"
          - OPTIMIZE: "效率优化"
        maintenance_commands:
          - PUMP_DOWN: "抽真空模式"
          - SERVICE_MODE: "维护模式"

      control_modes:
        operational_modes:
          - CONSTANT_TEMP: "恒定出水温度"
          - CONSTANT_PRESSURE: "恒定压力"
          - OPTIMIZATION: "效率优化"
          - NIGHT_PURGE: "夜间冲洗"
        startup_modes:
          - NORMAL_START: "正常启动"
          - SOFT_START: "软启动"
          - HOLIDAY_START: "节假日模式"
        fault_modes:
          - ANTI_SURGE: "防喘振控制"
          - SAFETY_SHUTDOWN: "安全停机"
          - MANUAL_OVERRIDE: "手动超越"

      control_loops:
        primary_loop:
          controlled_variable: "出水温度"
          manipulated_variable: "压缩机导叶片"
          control_algorithm: "PID + 前馈"
        secondary_loops:
          - condenser_loop: "冷却水温度"
          - oil_system_loop: "油压差"
          - motor_protection: "电流保护"

    # 告警规则
    alarm_rules:
      operational_alarms:
        temperature_alarms:
          chilled_water_high:
            limit: "10°C"
            severity: "HIGH"
            action: "检查负载+冷却系统"
          condenser_water_low:
            limit: "28°C"
            severity: "MEDIUM"
            action: "检查冷却塔"
        efficiency_alarms:
          low_cop:
            limit: "COP < 5.0"
            severity: "MEDIUM"
            action: "性能检查+维护"
          high_power_consumption:
            limit: "> design × 115%"
            severity: "HIGH"
            action: "系统诊断"

      safety_alarms:
        immediate_shutdown:
          motor_overcurrent:
            limit: "> 110% rated"
            severity: "CRITICAL"
            action: "立即停机+检查"
          high_discharge_pressure:
            limit: "> 安全阀设定值×90%"
            severity: "CRITICAL"
            action: "立即停机+call service"
          low_oil_pressure:
            limit: "< 最小油压差"
            severity: "CRITICAL"
            action: "立即停机+检查润滑"

      degradation_alarms:
        performance_trend:
          increasing_power_trend:
            criteria: "连续30天功率上升>5%"
            severity: "LOW"
            action: "安排维护+清洗"
          decreasing_efficiency:
            criteria: "COP下降>10%/年"
            severity: "MEDIUM"
            action: "系统诊断+大修"

    # 维护要求
    maintenance_requirements:
      preventive_maintenance:
        daily_checks:
          - visual_inspection: "外观检查"
          - noise_check: "异常噪音"
          - vibration_check: "基础振动"
        weekly_checks:
          - filter_inspection: "过滤器压差"
          - oil_level_check: "油位检查"
          - refrigerant_leak: "制冷剂泄漏"
        monthly_checks:
          - comprehensive_log: "运行记录分析"
          - efficiency_evaluation: "效率评估"
          - spare_parts_check: "备品备件状态"

      predictive_maintenance:
        quarterly:
          - oil_analysis: "润滑油分析"
          - vibration_analysis: "振动分析"
          - thermographic_scan: "热成像扫描"
        annually:
          - tube_inspection: "换热器管束检查"
          - motor_insulation: "电机绝缘测试"
          - control_calibration: "控制回路标定"

      corrective_maintenance:
        mean_time_to_repair:
          minor_repairs: "2-4小时"
          major_repairs: "1-3天"
          overhaul: "5-10天"
        spare_parts_list:
          - consumables: ["过滤器", "润滑油", "O型圈"]
          - wear_items: ["轴承", "密封件", "导叶片"]
          - critical_spares: ["压缩机备机", "电控备件"]

    # 关联设备关系
    related_equipment:
      upstream_equipment:
        - equipment_type: "HV_SWITCHGEAR"
          connection_type: "POWER_SUPPLY"
          interface_spec: "380V/3Ph/50Hz"
          protection_coordination: "选择性保护"
        - equipment_type: "COOLING_TOWER"
          connection_type: "HEAT_REJECTION"
          interface_spec: "32°C/37°C"
          flow_balance: "1.2×蒸发器流量"

      downstream_equipment:
        - equipment_type: "CHILLED_WATER_PUMP_PRIMARY"
          connection_type: "COOLING_DISTRIBUTION"
          interface_spec: "12°C/7°C"
          redundancy: "一对一配置"
        - equipment_type: "THERMAL_STORAGE_TANK"
          connection_type: "BUFFER_CONNECTION"
          interface_spec: "并联连接"
          control_strategy: "温差+分层控制"

      auxiliary_equipment:
        - equipment_type: "HVAC_CONTROL_PANEL"
          connection_type: "CONTROL_INTEGRATION"
          protocol: "Modbus/Fieldbus"
          signals: ["启停", "状态", "报警"]
        - equipment_type: "REFRIGERANT_MONITOR"
          connection_type: "SAFETY_MONITORING"
          monitoring: ["泄漏检测", "浓度报警"]
          protocol: "4-20mA/数字"

      measurement_equipment:
        - equipment_type: "TEMP_SENSOR"
          connection_type: "FLOW_MEASUREMENT"
          type: ["PT100", "热电偶"]
          accuracy: "±0.1°C"
        - equipment_type: "FLOW_METER"
          connection_type: "FLOW_MEASUREMENT"
          type: "电磁/超声波"
          accuracy: "±0.5%"
        - equipment_type: "POWER_METER"
          connection_type: "ENERGY_MONITORING"
          type: "多功能电能表"
          protocol: "Modbus"

      backup_equipment:
        - equipment_type: "STANDBY_GENERATOR"
          connection_type: "EMERGENCY_POWER"
          capacity: "维持关键系统"
          startup_time: "≤15秒"
        - equipment_type: "STANDBY_COOLING"
          connection_type: "N+1_REDUNDANCY"
          configuration: "模块化组合"
          auto_switch: "自动切换"

    lifecycle_properties:
      design_lifecycle:
        design_service_life: "25年"
        major_overhaul_period: "8-12年"
        compressor_overhaul: "40000小时"
      economics:
        capital_cost_range: "100-300万元"
        operating_cost_model: "电费+维护费+制冷剂费"
        payback_period: "节能措施3-5年"
      end_of_life:
        refrigerant_recovery: "环保回收"
        metal_recycling: "95%可回收"
        disposal_procedures: "符合环保要求"

