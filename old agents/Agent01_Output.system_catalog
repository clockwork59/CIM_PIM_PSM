          capacity: "≥7天用量"
          redundancy: "N+1"
        applications:
          - "手术室麻醉"
          - "ICU呼吸机"
          - "普通病房吸氧"
          - "急诊抢救"

      VAC: # Vacuum
        system_id: "MEDICAL_GAS-VAC"
        system_name: "医用真空系统"
        description: "负压吸引系统"
        criticality: "CRITICAL"
