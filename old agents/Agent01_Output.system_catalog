          - "配电箱"
          - "母线槽"
          - "低压电缆"
          - "断路器"
          - "电能质量监测"
        load_classification:
          first_class: "手术室、ICU、急诊科"
          second_class: "普通病房、电梯"
          third_class: "办公、景观照明"

      EPS: # Emergency Power System
        system_id: "ELECTRICAL-EPS"
        system_name: "应急电源系统"
        description: "备用电源系统，包括柴油发电机、UPS"
        criticality: "LIFE_SAFETY"
        components:
          - "柴油发电机组"
          - "UPS不间断电源"
          - "EPS应急照明电源"
          - "自动切换开关"
          - "发电机组控制柜"
          - "燃料供应系统"
        requirements:
          startup_time: "≤15秒"
          fuel_capacity: "≥24小时连续运行"
          load_coverage: "一级特别重要负荷"
          testing_frequency: "月度空载测试 + 年度负载测试"

      LGT: # Lighting System
        system_id: "ELECTRICAL-LGT"
        system_name: "照明系统"
        description: "室内外照明，含应急照明、医疗专用照明"
        criticality: "SECONDARY"
        components:
          - "LED照明灯具"
          - "照明配电箱"
          - "智能照明控制"
          - "应急照明"
          - "手术无影灯"
          - "紫外线消毒灯"
        requirements:
          illuminance: "按GB50034标准"
          emergency_duration: "≥90分钟"
          color_temperature: "3000-5000K (医疗场所)"

      IPS: # Isolated Power System
        system_id: "ELECTRICAL-IPS"
        system_name: "医用隔离电源系统"
        description: "手术室、ICU等医疗场所专用隔离电源"
        criticality: "PATIENT_SAFETY"
        medical_standards: "IEC 60364-7-710"
        components:
          - "医用隔离变压器"
          - "绝缘监视仪"
          - "外接报警显示"
          - "专用配电箱"
          - "漏电保护器"
        safety_features:
          isolation_voltage: "≥5500V AC"
          insulation_monitor: "实时监测绝缘电阻"
          fault_alarm: "第一故障报警"
          fault_location: "故障定位功能"

