# 医疗建筑技术系统目录 (Medical Building Technology Systems Catalog)
# 基于CIM模型的8大系统类别分类

system_categories:
  HVAC:
    category_id: "HVAC"
    category_name: "暖通空调系统"
    category_name_en: "Heating, Ventilation and Air Conditioning"
    description: "医疗建筑环境与空气处理系统"
    criticality_level: "CRITICAL"
    healthcare_specific: true

    subsystems:
      CHP: # Chiller Plant
        system_id: "HVAC-CHP"
        system_name: "冷源系统"
        description: "中央制冷系统，包括冷水机组、冷却塔、冷冻水泵"
        criticality: "CRITICAL"
        service_areas: ["全科", "手术室", "ICU", "药房", "检验科"]
        components:
          - "冷水机组(Chiller)"
          - "冷却塔(Cooling Tower)"
          - "冷冻水泵(Chilled Water Pump)"
          - "冷却水泵(Condenser Water Pump)"
          - "膨胀水箱(Expansion Tank)"
          - "分集水器(Hydraulic Separator)"
          - "水处理设备"
        energy_profile:
          power_consumption: "HIGH"
          load_type: "COOLING_LOAD"
          efficiency_target: "≥5.0 COP"
        operational_parameters:
          supply_temp: "7/12°C"
          delta_t: "5-7°C"
          flow_rate: "Variable"
          control_strategy: "VFD + ΔT优化"

      HTP: # Heat Plant
        system_id: "HVAC-HTP"
        system_name: "热源系统"
        description: "中央供热系统，包括锅炉、热泵、热水泵"
        criticality: "CRITICAL"
        service_areas: ["全科", "手术室", "ICU", "病房", "热水供应"]
        components:
          - "蒸汽/热水锅炉"
          - "热泵机组"
          - "热水泵(Hot Water Pump)"
          - "热交换器(Heat Exchanger)"
          - "膨胀水箱"
          - "分汽缸/分水器"
          - "水处理设备"
        energy_profile:
          fuel_types: ["天然气", "电力", "柴油"]
          efficiency_target: "≥90% 热效率"
          emissions: "需满足医疗级排放标准"
        operational_parameters:
          supply_temp: "60/80°C"
          delta_t: "20°C"
          control_strategy: "气候补偿 + 分时分区"

      AHU: # Air Handling Units
        system_id: "HVAC-AHU"
        system_name: "空气处理系统"
        description: "中央空调机组系统，包括新风、回风、送风处理"
        criticality: "CRITICAL"
        service_areas: ["全科", "手术室", "ICU", "洁净区"]
        components:
          - "组合式空调机组"
          - "新风机组"
          - "风机盘管"
          - "变风量末端(VAV)"
          - "过滤器(初效/中效/高效)"
          - "加湿器"
          - "紫外线杀菌装置"
        air_quality_requirements:
          filtration: "≥99.97% @ 0.3μm"
          ventilation_rate: "6-15 ACH"
          pressure_cascade: "洁净区→半洁净区→普通区"
          temperature: "24±2°C"
          humidity: "50±10%"

      CLN: # Cleanroom HVAC
        system_id: "HVAC-CLN"
        system_name: "洁净空调系统"
        description: "手术室、ICU、药房等洁净环境专用空调系统"
        criticality: "CRITICAL"
        service_areas: ["手术室", "ICU", "NICU", "药房", "检验科"]
        cleanliness_levels:
          OR: "ISO 5级 (百级)"
          ICU: "ISO 7级 (万级)"
          Pharmacy: "ISO 8级 (十万级)"
        components:
          - "专用净化空调机组"
          - "HEPA/ULPA过滤器"
          - "层流送风天花"
          - "回风口"
          - "压差控制器"
          - "温湿度精密控制器"
        requirements:
          laminar_flow: "垂直层流/水平层流"
          pressure_differential: "15-30 Pa"
          air_changes: "20-40 ACH"
          recovery_time: "≤30 min"

      ISO: # Isolation HVAC
        system_id: "HVAC-ISO"
        system_name: "负压隔离系统"
        description: "传染病负压隔离病房专用通风系统"
        criticality: "CRITICAL"
        service_areas: ["负压隔离病房", "传染病区", "BSL实验室"]
        biosafety_levels:
          BSL-2: "基础负压隔离"
          BSL-3: "加强负压隔离"
        components:
          - "全新风空调机组"
          - "HEPA过滤器(排风)"
          - "负压排风机"
          - "压差监控器"
          - "气流方向指示器"
          - "紧急通风系统"
        safety_features:
          pressure_differential: "-30 Pa (相对相邻区)"
          air_changes: "12-15 ACH"
          exhaust_filtration: "99.97% HEPA"
          backup_power: "24小时应急保障"
          failure_alarm: "实时压力监测报警"

      SMO: # Smoke Control
        system_id: "HVAC-SMO"
        system_name: "通风排烟系统"
        description: "消防排烟、日常通风系统"
        criticality: "LIFE_SAFETY"
        service_areas: ["地下车库", "中庭", "楼梯间", "前室"]
        components:
          - "消防排烟风机"
          - "正压送风机"
          - "排烟口/送风口"
          - "防火阀"
          - "排烟防火阀"
          - "风压传感器"
        fire_safety:
          smoke_extraction: "≥6 ACH (火灾时)"
          pressurization: "50 Pa (楼梯间)"
          smoke_free_zone: "≤8 min 目标时间"

  PLUMBING:
    category_id: "PLUMBING"
    category_name: "给排水系统"
    category_name_en: "Plumbing Systems"
    description: "医疗建筑给排水及水处理系统"
    criticality_level: "CRITICAL"
    healthcare_specific: true

    subsystems:
      WSS: # Water Supply System
        system_id: "PLUMBING-WSS"
        system_name: "生活给水系统"
        description: "饮用水供应系统，包括市政供水加压、储水"
        criticality: "CRITICAL"
        components:
          - "市政供水引入管"
          - "生活水箱"
          - "变频供水设备"
          - "给水泵"
          - "管道系统"
          - "阀门配件"

      HWS: # Hot Water System
        system_id: "PLUMBING-HWS"
        system_name: "热水供应系统"
        description: "医疗生活热水系统，含热水制备、循环"
        criticality: "SECONDARY"
        components:
          - "热水锅炉/换热器"
          - "热水储罐"
          - "热水循环泵"
          - "热水管道"
          - "混水阀"
          - "温度控制器"
        temperature_control:
          supply_temp: "60-65°C"
          use_temp: "40-45°C"
          circulation: "24小时连续循环"

      DRN: # Drainage System
        system_id: "PLUMBING-DRN"
        system_name: "排水系统"
        description: "污水、废水、雨水排放系统"
        criticality: "SECONDARY"
        components:
          - "排水管道"
          - "化粪池"
          - "污水处理设备"
          - "雨水收集系统"
          - "通气管"
          - "检查井"
        healthcare_special:
          medical_wastewater: "需预处理后方可排放"
          biochemical_treatment: "实验室废水特殊处理"

      PW: # Pure Water
        system_id: "PLUMBING-PW"
        system_name: "医用纯水系统"
        description: "实验室、手术室、消毒供应中心纯水制备"
        criticality: "CRITICAL"
        applications:
          - "实验室检验用水"
          - "手术器械清洗"
          - "制药配液"
          - "消毒供应"
        water_quality:
          resistivity: "≥10 MΩ·cm"
          conductivity: "≤0.1 μS/cm"
          TOC: "≤500 ppb"
          bacteria: "≤10 CFU/100ml"
        components:
          - "预处理系统"
          - "反渗透设备"
          - "离子交换器"
          - "超滤装置"
          - "紫外线杀菌"
          - "精密过滤器"

  ELECTRICAL:
    category_id: "ELECTRICAL"
