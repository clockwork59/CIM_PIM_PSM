# 医疗建筑技术系统间依赖关系模型
# Agent-01: 系统间依赖关系分析

system_interdependencies:
  framework:
    dependency_levels:
      - "FUNDAMENTAL"     # 基础依赖，缺失将直接危及生命安全
      - "CRITICAL"        # 关键依赖，缺失将严重影响医院运营
      - "IMPORTANT"       # 重要依赖，缺失将影响医疗服务质量
      - "SECONDARY"       # 次要依赖，缺失将影响但整体可承受
      - "AUXILIARY"       # 辅助依赖，缺失基本无影响

    dependency_categories:
      - "POWER_SUPPLY"           # 电能供给依赖
      - "MEDIUM_SUPPLY"          # 介质供给依赖 (冷热水、蒸汽、气体等)
      - "CONTROL_DATA"           # 控制信号与数据交换
      - "ENVIRONMENTAL_COND"     # 环境条件依赖
      - "SPACE_REQUIRED"         # 空间共用依赖
      - "MAINTENANCE_ACCESS"     # 维护通道依赖

  # 系统间依赖关系矩阵
  dependency_matrix:
    # HVAC-CHP 冷源系统为核心，展示其对其他系统的依赖
    HVAC-CHP_DEPENDENCIES:
      depends_on:
        - system: "ELECTRICAL-HV"
          interfaces: ["主电源输入", "功率实时监测"]
          interface_type: "POWER_SUPPLY"
          power_levels:
            - "10kV 高压电源 (主要制冷机组)"
            - "380V/3P 动力配电 (水泵、冷却塔风机)"
            - "220V/1P 控制电源 (自控系统、仪表)"
          reliability_class: "FUNDAMENTAL"
          backup_requirement: "双电源 + 柴油发电机秒级投入"
          failure_impact: "冷源系统停机，全建筑空调失效"
          reg_recovery_time: "≤15秒，备用电源投入"
          power_consumption: "约2,000 kW 峰值负荷"
          load_profile: "制冷期高负荷，非制冷期待机/检修"

        - system: "ELECTRICAL-EPS"
          interfaces: ["应急电源输入", "UPS不间断"]
          interface_type: "POWER_SUPPLY"
          power_levels:
            - "关键控制回路 UPS"
            - "应急照明/指示"
            - "安全保护系统"
          reliability_class: "FUNDAMENTAL"
          backup_requirement: "柴油发电机自动启动"
          failure_impact: "自控失效，转为手动运行"
          recovery_time: "≤15秒"
          special_benefits: "保证关键负荷不中断"

        - system: "PLUMBING-WSS"
          interfaces: ["冷却塔补水", "冷冻水膨胀补水"]
          interface_type: "MEDIUM_SUPPLY"
          water_specifications:
            - "冷却水系统补充水量: 50 m³/h (平均)"
            - "冷冻水系统膨胀补水: 5 m³/h (峰值)"
            - "水质要求: 总硬度 ≤150mg/L (以CaCO3计)"
            - "水压要求: 0.25-0.35 MPa (表压)"
          reliability_class: "CRITICAL"
          backup_requirement: "双路市政供水 + 水箱储水 (≥24小时)"
          failure_impact: "冷却水系统缺水，制冷效能下降直至停机"
          water_quality_impact: "结垢和腐蚀，降低传热效率"
          water_conservation: "采用中水回用冷却塔补水(经适当处理)"

        - system: "BUILDING_AUTOMATION-BAS"
          interfaces: ["实时监控", "优化控制", "故障报警"]
          interface_type: "CONTROL_DATA"
          protocols: ["Modbus TCP/IP", "BACnet/IP", "OPC UA"]
          data_exchange:
            - "实时能耗数据"
            - "环境参数 (T, RH, P)"
            - "设备状态信号"
            - "报警信息"
            - "控制设定值修正"
          reliability_class: "CRITICAL"
          backup_requirement: "本地控制器独立运行 + 手动模式"
          failure_impact: "无法进行优化运行，投回基本程式运行"
          data_refresh_rate: "1-5秒扫描周期"
          network_requirement: "千兆以太网 + 冗余配置"
          cyber_security: "加密传输 + 身份认证"

        - system: "BUILDING_AUTOMATION-EMS"
          interfaces: ["能耗数据上传", "能效分析", "绩效比较"]
          interface_type: "CONTROL_DATA"
          data_types:
            - "电功率数据 (实时)"
            - "冷量数据 (按小时累计)"
            - "效率指标 (COP 实时计算)"
            - "成本分析"
            - "碳排放核算"
          reliability_class: "IMPORTANT"
          backup_requirement: "本地数据存储 (≥30天)"
          failure_impact: "无法进行能耗分析和绩效评估"
          data_integrity: "年累计误差≤±2%"
          calculation_accuracy: "COP计算准确度≥±0.1"

      provides_to:
        - system: "HVAC-AHU"
          interfaces: ["冷冻水供应", "除湿能力"]
          interface_type: "MEDIUM_SUPPLY"
          cooling_medium:
            - "7/12°C 冷冻水"
            - "除湿潜冷能力"
            - "capable chilled water"
          capacity_spec:
            - "cold_comfort_for_air_handling_units"
            - "total_service_cooling_load"
          reliability_level: "为空调系统提供基础冷源，不可或缺"
          performance_impact: "冷源直接决定空调系统制冷效果"

        - system: "HVAC-CLN"
          interfaces: ["高精度冷却", "去湿处理"]
          interface_type: "MEDIUM_SUPPLY"
          cooling_specifications:
            - "温度精度: ±1°C"
            - "湿度控制: 露点除湿"
            - "backup_cooling_capability"
          medical_reliability: "CRITICAL - 直接影响力手术室和ICU环境"
          performance_requirements: "支持ISO洁净度等级的环境控制"
          redundant_supply: "提供N+1或2N多路冷源保障"

        - system: "HVAC-ISO"
          interfaces: ["全新风冷却", "空气除湿处理"]
          interface_type: "MEDIUM_SUPPLY"
          cooling_requirement:
            - "全空气系统新风冷却"
            - "高密度使用下的除湿能力"
            - "保证足够ptl冷却量"
          healthcare_criticality: "CRITICAL - 保证传染病房负压隔离"
          unique_requirement: "全新风运行模式下的高负荷冷却"
          fail_safe_feature: "旁通冷却或独立冷源备选"

  # 以其他系统视角的依赖关系分析
  # 从供电系统角度 - 它是基础设施，几乎所有其他系统依赖它
  ELECTRICAL-HV_DEPENDENCIES:
    depends_on:
      - system: "ELECTRICAL-EPS"
        interface: "应急电源保障"
        criticality: "FUNDAMENTAL"
      - system: "BUILDING_AUTOMATION-BAS"
        interface: "继电保护与自动化"
        criticality: "CRITICAL"
    provides_to:
      - system: "HVAC-CHP"
        demand: "~2000 kW"
        criticality: "FUNDAMENTAL"
      - system: "ELECTRICAL-LV"
        demand: "全建筑分配"
        criticality: "FUNDAMENTAL"
      - system: "VERTICAL_TRANSPORT"
        demand: "~500 kW"
        criticality: "CRITICAL"
      - system: "BUILDING_AUTOMATION"
        demand: "~200 kW"
        criticality: "CRITICAL"

  # 医疗气体系统依赖 - 直接涉及患者安全
  MEDICAL_GAS_DEPENDENCIES:
    depends_on:
      - system: "ELECTRICAL-HV"
        interface_type: "POWER_SUPPLY"
        reliability_class: "FUNDAMENTAL"
        critical_packages: ["氧气源设备", "真空泵", "压力监控"]
      - system: "ELECTRICAL-EPS"
        interface_type: "POWER_SUPPLY"
        backup_requirement: "柴油发电机自动切换"
        critical_packages: ["医用氧汇流排", "MOXI 设备", "监控系统"]
      - system: "HVAC-CLN"
        interface_type: "ENVIRONMENTAL_COND"
        requirements: "为气体储存和处理设备提供洁净环境"
      - system: "BUILDING_AUTOMATION-BAS"
        interface_type: "CONTROL_DATA"
        protocols: ["RS485", "Modbus"
        monitoring: ["压力在线监测", "gas_level_monitoring", "source_switch"]

    provides_to:
      - system: "FIRE_PROTECTION"
        interface: ""
        description: "提供惰性气体系统 (如IG541)"

  # 洁净空调系统
  HVAC-CLN_DEPENDENCIES:
    depends_on:
      POWER_SUPPLY: "ELECTRICAL-HV/EPS"
      COOLING_SOURCE: "HVAC-CHP"
      ENVIRONMENTAL_SUPERVISION: "BUILDING_AUTOMATION-BAS"
      MAINTENANCE_ACCESS: "从建筑空间分配而来"
    provides_crucial:
      to_personnel: "ISO 5-8级洁净空间"
      to_patients: "手术期感染防控"
      to_correct_procedure: "洁净手术环境保障"

  # 楼宇自动化系统 - 横向连接各系统的协调中枢
  BUILDING_AUTOMATION_DEPENDENCIES:
    depends_on:
      - system: "ELECTRICAL-HV"
        power: "~200 kW 系统负载"
        reliability: "FUNDAMENTAL"
      - system: "ELECTRICAL-EPS"
        backup_power: "UPS 和柴油发电机"
      - system: "NETWORK_INFRASTRUCTURE"
        communication: "千兆以太网 + 冗余"
    coordinates_with:
      - HORIZONTAL_INTEGRATION:
          - "HVAC全系列 (CHP/HTP/AHU/CLN/ISO/SMO)"
          - "ELECTRICAL系列 (HV/LV/EPS/LGT/IPS)"
          - "PLUMBING系列 (WSS/HWS/DRN/PW)"
          - "MEDICAL_GAS系列 (O2/VAC/AIR/N2O/CO2)"
          - "FIRE_PROTECTION系列 (HYDRANT/SPRINKLER/ALARM)"
          - "VERTICAL_TRANSPORT系列 (ELEVATOR/ESCALATOR)"

  # 消防系统
  FIRE_PROTECTION_DEPENDENCIES:
    depends_on:
      - system: "ELECTRICAL-HV"
        interfaces: ["消防泵动力", "报警系统电源", "控制设备用电"]
        power_levels: ["消防泵 220-1800kW", "报警系统 220V", "控制系统 24V DC"]
        reliability: "FUNDAMENTAL - 生命安全"
      - system: "ELECTRICAL-EPS"
        backup_requirement: "火灾时消防负荷由应急电源保障"
      - system: "PLUMBING-WSS"
        supply: "消防蓄水池 + 市政水"
        reliability: "不少于2路供水 + 消防水池"
        storage_requirement: "火灾延续时间3小时"
      - system: "BUILDING_AUTOMATION-BAS"
        integration: ["火灾报警", "设备联动", "排烟控制取悦", "电梯归巢"]
        protocols: ["消防专用协议", "与BAS协议整合"]
      - system: "HVAC-SMO"
        complement: "形成完整防排烟系统"

  # 垂直交通系统
  VERTICAL_TRANSPORT_DEPENDENCIES:
    depends_on:
      - system: "ELECTRICAL-HV"
        power_demand: ">500 kW 峰值"
        power_type: "380V/3P 动力电"
        reliability_class: "CRITICAL"
      - system: "ELECTRICAL-EPS"
        backup_power: "火灾归巢功能"
        requirement: "乘客梯级降运行"
      - system: "ELECTRICAL-LV"
        controls: "照明 + 操控 + 报警"
      - system: "VENTILATION_OR_ENCLOSURE"
        ventilation: "机房通风散热"

# 系统级联影响分析
system_cascading_impacts:
  FUNDAMENTAL_DEPENDENCY_FAILURE_CHAIN:
    trigger: "ELECTRICAL-HV 主电源中断"
    propagation:
      tier_1_affected:
        - "HVAC-CHP 停机 (无冷冻水)"
        - "HVAC-HTP 停机 (无热水)"
        - "PLUMBING 供水系统 (泵类设备停)"
        - "HVAC-AHU (送风机停)"
        - "ERISCALATOR 停用"
        - "BUILDING_AUTOMATION 失效 (部分)"

      tier_2_consequences:
        - "手术室环境失效 (HVAC-CLN受影响)"
        - "ICU空调停药 (患者安全风险)"
        - "负压隔离失效 (HVAC-ISO)"
        - "普通区域空调失效"
        - "电梯回巢 (消防联动: VERTICAL_TRANSPORT)"
        - "医疗气体系统转为备用 (MEDICAL_GAS)"

      backup_activation:
        - "柴油发电机自动启动 (≤15秒)"
        - "UPS不间断电源提供关键负荷"
        - "医疗气体汇流排自动切换"
        - "消防系统不受影响 (独立备用电源)"
        - "部分系统自动降级运行"

  COOLING_SOURCE_FAILURE_CHAIN:
    trigger: "HVAC-CHP 冷源系统失效"
    propagation:
      cooling_impacts:
        - "HVAC-AHU 降温/除湿能力失效"
        - "HVAC-CLN 洁净环境失控"
        - "室内环境温度升高 (2-4°C/h)"
        - "相对湿度失控 (RH%上升)"
      healthcare_consequences:
        - "手术室被迫暂停使用"
        - "ICU环境恶化，需紧急评估"
        - "药品存储条件恶化"
        - "医疗设备过热风险"
      mitigation_actions:
        - "启用备用制冷机组"
        - "开启大楼自然通风"
        - "使用移动制冷设备"
        - "转移重症患者"

# 系统冗余和容错设计
system_redundancy_design:

  power_supply_redundancy:
    hierarchy:
      level_0: "双路市政电源"
      level_1: "双变压器 + 双馈线"
      level_2: "柴油发电机自动投入"
      level_3: "UPS不间断电源"

  cooling_source_redundancy:
    approaches:
      - "设备级冗余: 冷水机组 N+1 配置"
      - "系统级冗余: 分区独立冷源"
      - "区域级冗余: 关键区域双回路冷源"

  medical_system_redundancy:
    requirements:
      oxygen_system: "备用汇流排 + 储氧设备"
      vacuum_system: "备用真空泵 + 分隔区域供真"
      isolation_system: "分区独立控制 + 物理隔断经"

