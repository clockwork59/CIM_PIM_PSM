    },
    {
      "id": 5, "name": "启动疏散", "name_en": "Evacuation",
      "role": "SecurityTeamLeader", "mode": "ManualExecution",
      "time_limit_sec": 600, "depends_on": [4],
      "bas_command": null
    },
    {
      "id": 6, "name": "打开门禁", "name_en": "Door Release",
      "role": "SYSTEM", "mode": "AutomaticExecution",
