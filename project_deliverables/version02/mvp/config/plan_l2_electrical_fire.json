      "time_limit_sec": 30, "depends_on": [1],
      "bas_command": "PowerCutoffCommand"
    },
    {
      "id": 3, "name": "启动灭火", "name_en": "Fire Suppression",
      "role": "ElectricalTechnician", "mode": "ManualExecution",
