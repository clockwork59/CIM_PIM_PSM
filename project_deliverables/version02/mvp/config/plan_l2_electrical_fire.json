  "roles": {
    "ControlRoomOperator": {"label": "中控值班员", "permission": "R2"},
    "SecurityTeamLeader": {"label": "保安队长", "permission": "R2"},
    "ElectricalTechnician": {"label": "电工班", "permission": "R1"},
