# =============================================================================
# 仿真场景实例数据 — 5F 普通病房层（简化版 MVP）
# Simulation Scenario: 5F Ward Floor (Simplified)
#
# 包含（按裁决要求简化为3间代表性病房）:
#   - 3 间单人病房 (SingleBedWard, 5F-WARD-01/06/12)
#   - 1 个护士站 (NurseStation, 5F-NS-01)
#   - 1 条走廊 (Corridor, 5F-CORRIDOR)
#   - 1 间机房 (MechanicalRoom, 5F-MECH)
#   - 1× AHU + 3× FCU (FCU-ZONE-049~051, 避免与现有实例冲突)
#   - 温湿度/CO2 传感器
#   - DDC 控制器 + 送风温控回路
#   - 配电箱 + UPS 应急电源
#   - 护理呼叫面板
#   - BFO 生命周期过程声明（6阶段完整链）
#
# Version: 2.0 | 2026-05-10 (风险裁决修订版)
# =============================================================================

@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .

@prefix cim:       <https://cim.medical/ontology/v3.4#> .
@prefix cim-equip: <https://cim.medical/ontology/v3.4/equipment#> .
@prefix cim-space: <https://cim.medical/ontology/v3.4/space#> .
@prefix cim-flow:  <https://cim.medical/ontology/v3.4/flow#> .
@prefix cim-ctrl:  <https://cim.medical/ontology/v3.4/control#> .
@prefix cim-c:     <https://cim.medical/ontology/v4.0/conceptual#> .
@prefix cim-med:   <https://cim.medical/ontology/v4.0/medium#> .
@prefix cim-d:     <https://cim.medical/ontology/v4.0/design#> .
@prefix cim-f:     <https://cim.medical/ontology/v4.0/foundational#> .
@prefix cim-ref:   <https://cim.medical/ontology/v4.0/reference#> .
@prefix cim-o:     <https://cim.medical/ontology/v4.0/operational#> .
@prefix cim-cs:    <https://cim.medical/ontology/v4.0/control_strategy#> .
@prefix sosa:      <http://www.w3.org/ns/sosa/> .

@prefix inst: <http://cim.medical/instance/ward_floor_5f#> .

# =============================================================================
# 建筑层级
# =============================================================================

inst:Hospital_Building a cim-space:Building ;
    rdfs:label "某三甲医院"@zh-CN .

inst:Floor_5F a cim-space:Floor ;
    rdfs:label "5层（普通病房层）"@zh-CN ;
    cim-space:isPartOf inst:Hospital_Building .

# =============================================================================
# 空间实例 — 3间代表性病房（裁决简化版）
# =============================================================================

inst:5F-WARD-01 a cim-space:SingleBedWard ;
    rdfs:label "5F 单人病房 01（首端）"@zh-CN ;
    cim-space:isPartOf inst:Floor_5F ;
    cim-d:requiredAreaSqm "18.0"^^xsd:decimal ;
    cim-d:airChangesPerHour "6"^^xsd:integer ;
    cim-d:pressureClass "neutral" ;
    cim-d:minValue "20.0"^^xsd:decimal .

inst:5F-WARD-06 a cim-space:SingleBedWard ;
    rdfs:label "5F 单人病房 06（中段）"@zh-CN ;
    cim-space:isPartOf inst:Floor_5F ;
    cim-d:requiredAreaSqm "18.0"^^xsd:decimal ;
    cim-d:airChangesPerHour "6"^^xsd:integer ;
    cim-d:pressureClass "neutral" ;
    cim-d:minValue "20.0"^^xsd:decimal .

inst:5F-WARD-12 a cim-space:SingleBedWard ;
    rdfs:label "5F 单人病房 12（末端）"@zh-CN ;
    cim-space:isPartOf inst:Floor_5F ;
    cim-d:requiredAreaSqm "18.0"^^xsd:decimal ;
    cim-d:airChangesPerHour "6"^^xsd:integer ;
    cim-d:pressureClass "neutral" ;
    cim-d:minValue "20.0"^^xsd:decimal .

# ── 辅助空间 ──────────────────────────────────────────────────────────────────
inst:5F-NS-01 a cim-space:NurseStation ;
    rdfs:label "5F 护士站"@zh-CN ;
    cim-space:isPartOf inst:Floor_5F .

inst:5F-CORRIDOR a cim-space:Corridor ;
    rdfs:label "5F 走廊"@zh-CN ;
    cim-space:isPartOf inst:Floor_5F .

inst:5F-MECH a cim-space:MechanicalRoom ;
    rdfs:label "5F 机房"@zh-CN ;
    cim-space:isPartOf inst:Floor_5F .

# =============================================================================
# 暖通空调系统 (HVAC)
# =============================================================================

inst:AHU_WARD_5F a cim-equip:AHU ;
    rdfs:label "5F病房层空调箱 AHU-WARD-5F-01"@zh-CN ;
    cim-d:designTag "AHU-WARD-5F-01" ;
    cim-d:ratedCapacity "8000.0"^^xsd:decimal ;
    cim-d:ratedPower "11.0"^^xsd:decimal ;
    cim-space:locatedIn inst:5F-MECH ;
    cim-c:hasConnectionPoint inst:AHU_5F_SAout ;
    cim-c:hasConnectionPoint inst:AHU_5F_RAin ;
    cim-c:hasConnectionPoint inst:AHU_5F_OAin .

inst:AHU_5F_SAout a cim-c:OutletConnectionPoint ;
    cim-c:hasMedium cim-med:SupplyAir ;
    cim-c:connectsTo inst:FP_SA_MAIN_5F .

inst:AHU_5F_RAin a cim-c:InletConnectionPoint ;
    cim-c:hasMedium cim-med:ReturnAir ;
    cim-c:connectsTo inst:FP_RA_MAIN_5F .

inst:AHU_5F_OAin a cim-c:InletConnectionPoint ;
    cim-c:hasMedium cim-med:OutdoorAir .

# ── 送风系统（3路支管）─────────────────────────────────────────────────────────
inst:FP_SA_MAIN_5F a cim-flow:SupplyAirFlow ;
    rdfs:label "5F 主送风干管"@zh-CN ;
    cim-c:hasMedium cim-med:SupplyAir ;
    cim-c:connectsTo inst:FP_SA_5F_W01 ;
    cim-c:connectsTo inst:FP_SA_5F_W06 ;
    cim-c:connectsTo inst:FP_SA_5F_W12 .

inst:FP_SA_5F_W01 a cim-flow:SupplyAirFlow ;
    cim-c:hasMedium cim-med:SupplyAir ; cim-c:connectsTo inst:DIFFUSER_5F_W01 .
inst:FP_SA_5F_W06 a cim-flow:SupplyAirFlow ;
    cim-c:hasMedium cim-med:SupplyAir ; cim-c:connectsTo inst:DIFFUSER_5F_W06 .
inst:FP_SA_5F_W12 a cim-flow:SupplyAirFlow ;
    cim-c:hasMedium cim-med:SupplyAir ; cim-c:connectsTo inst:DIFFUSER_5F_W12 .

# ── 送风口 ─────────────────────────────────────────────────────────────────────
inst:DIFFUSER_5F_W01 a cim-equip:SupplyAirDiffuser ;
    rdfs:label "W01 送风口"@zh-CN ;
    cim-space:locatedIn inst:5F-WARD-01 ;
    cim-c:hasConnectionPoint inst:DIFF_5F_W01_in .
inst:DIFF_5F_W01_in a cim-c:InletConnectionPoint ;
    cim-c:hasMedium cim-med:SupplyAir ; cim-c:connectsTo inst:FP_SA_5F_W01 .

inst:DIFFUSER_5F_W06 a cim-equip:SupplyAirDiffuser ;
    rdfs:label "W06 送风口"@zh-CN ;
    cim-space:locatedIn inst:5F-WARD-06 ;
    cim-c:hasConnectionPoint inst:DIFF_5F_W06_in .
inst:DIFF_5F_W06_in a cim-c:InletConnectionPoint ;
    cim-c:hasMedium cim-med:SupplyAir ; cim-c:connectsTo inst:FP_SA_5F_W06 .

inst:DIFFUSER_5F_W12 a cim-equip:SupplyAirDiffuser ;
    rdfs:label "W12 送风口"@zh-CN ;
    cim-space:locatedIn inst:5F-WARD-12 ;
    cim-c:hasConnectionPoint inst:DIFF_5F_W12_in .
inst:DIFF_5F_W12_in a cim-c:InletConnectionPoint ;
    cim-c:hasMedium cim-med:SupplyAir ; cim-c:connectsTo inst:FP_SA_5F_W12 .

# ── 回风系统 ───────────────────────────────────────────────────────────────────
inst:FP_RA_MAIN_5F a cim-flow:ReturnAirFlow ;
    rdfs:label "5F 回风总管"@zh-CN ;
    cim-c:hasMedium cim-med:ReturnAir .

inst:RA_GRILLE_5F_W01 a cim-equip:ReturnAirGrille ;
    rdfs:label "W01 回风口"@zh-CN ; cim-space:locatedIn inst:5F-WARD-01 .
inst:RA_GRILLE_5F_W06 a cim-equip:ReturnAirGrille ;
    rdfs:label "W06 回风口"@zh-CN ; cim-space:locatedIn inst:5F-WARD-06 .
inst:RA_GRILLE_5F_W12 a cim-equip:ReturnAirGrille ;
    rdfs:label "W12 回风口"@zh-CN ; cim-space:locatedIn inst:5F-WARD-12 .

# ── 3× FCU（编号 FCU-ZONE-049~051，避免与现有实例冲突）─────────────────────────
inst:FCU_ZONE_049 a cim-equip:FCU ;
    rdfs:label "5F FCU-ZONE-049"@zh-CN ;
    cim-d:designTag "FCU-ZONE-049" ;
    cim-space:locatedIn inst:5F-WARD-01 .

inst:FCU_ZONE_050 a cim-equip:FCU ;
    rdfs:label "5F FCU-ZONE-050"@zh-CN ;
    cim-d:designTag "FCU-ZONE-050" ;
    cim-space:locatedIn inst:5F-WARD-06 .

inst:FCU_ZONE_051 a cim-equip:FCU ;
    rdfs:label "5F FCU-ZONE-051"@zh-CN ;
    cim-d:designTag "FCU-ZONE-051" ;
    cim-space:locatedIn inst:5F-WARD-12 .

# =============================================================================
# 传感器
# =============================================================================

inst:TS_5F_CORR a cim-ctrl:TemperatureSensor ;
    rdfs:label "5F 走廊温度传感器"@zh-CN ; cim-space:locatedIn inst:5F-CORRIDOR .
inst:TS_5F_W01 a cim-ctrl:TemperatureSensor ;
    rdfs:label "5F W01 温度传感器"@zh-CN ; cim-space:locatedIn inst:5F-WARD-01 .
inst:HS_5F_CORR a cim-ctrl:HumiditySensor ;
    rdfs:label "5F 走廊湿度传感器"@zh-CN ; cim-space:locatedIn inst:5F-CORRIDOR .
inst:CO2_5F_CORR a cim-ctrl:CO2Sensor ;
    rdfs:label "5F 走廊 CO2 传感器"@zh-CN ; cim-space:locatedIn inst:5F-CORRIDOR .

# =============================================================================
# DDC 控制器与控制回路
# =============================================================================

inst:DDC_SUB_5F_01 a cim-cs:DDCController ;
    rdfs:label "5F DDC 子站 DDC-SUB-5F-01"@zh-CN ;
    cim-d:designTag "DDC-SUB-5F-01" ;
    cim-space:locatedIn inst:5F-MECH .

inst:CL_SAT_5F a cim-cs:SupplyAirTemperatureControl ;
    rdfs:label "5F AHU 送风温度控制回路"@zh-CN ;
    cim-cs:hasController inst:DDC_SUB_5F_01 ;
    cim-cs:controlsEquipment inst:AHU_WARD_5F .

# =============================================================================
# 电气系统
# =============================================================================

inst:DistPanel_5F a cim-equip:DistributionPanel ;
    rdfs:label "5F 配电箱 DP-5F-01"@zh-CN ;
    cim-d:designTag "DP-5F-01" ;
    cim-space:locatedIn inst:5F-MECH ;
    cim-c:hasConnectionPoint inst:DP_5F_in .

inst:DP_5F_in a cim-c:InletConnectionPoint ;
    cim-c:hasMedium cim-med:EmergencyPower ;
    cim-c:connectsTo inst:FP_EPWR_UPS_DP5F .

inst:FP_EPWR_UPS_DP5F a cim-flow:EmergencyPowerFlow ;
    cim-c:hasMedium cim-med:EmergencyPower .

# =============================================================================
# 护理呼叫
# =============================================================================

inst:NC_PANEL_5F_01 a cim-equip:Equipment ;
    rdfs:label "5F 护理呼叫主面板 NC-5F-01"@zh-CN ;
    cim-d:designTag "NC-5F-01" ;
    cim-space:locatedIn inst:5F-NS-01 .

# =============================================================================
# BFO 生命周期过程声明（6阶段完整链）
# =============================================================================

inst:Project_ConceptualDesign a cim-f:ConceptualDesignProcess ;
    rdfs:label "5F病房层方案设计过程"@zh-CN ;
    cim-f:processStageCode "CONCEPT" ;
    cim-f:processStartDate "2025-09-01"^^xsd:date ;
    cim-f:processEndDate   "2025-11-30"^^xsd:date ;
    cim-f:hasMilestone inst:Milestone_Concept_Approval .

inst:Milestone_Concept_Approval a cim-f:DesignApprovalMilestone ;
    rdfs:label "方案设计审批通过"@zh-CN .

inst:Project_SchematicDesign a cim-f:SchematicDesignProcess ;
    rdfs:label "5F病房层初步设计过程"@zh-CN ;
    cim-f:processStageCode "SD" ;
    cim-f:processStartDate "2025-12-01"^^xsd:date ;
    cim-f:processEndDate   "2026-02-28"^^xsd:date .

inst:Project_DetailedDesign a cim-f:DetailedDesignProcess ;
    rdfs:label "5F病房层施工图设计过程"@zh-CN ;
    cim-f:processStageCode "DD" ;
    cim-f:processStartDate "2026-03-01"^^xsd:date ;
    cim-f:processEndDate   "2026-05-31"^^xsd:date ;
    cim-f:hasMilestone inst:Milestone_IDM_DD .

inst:Milestone_IDM_DD a cim-f:InformationDeliveryMilestone ;
    rdfs:label "施工图信息交付里程碑"@zh-CN .

inst:Project_Tendering a cim-f:TenderingProcess ;
    rdfs:label "5F病房层招投标过程"@zh-CN ;
    cim-f:processStageCode "TENDER" ;
    cim-f:processStartDate "2026-06-01"^^xsd:date ;
    cim-f:processEndDate   "2026-07-31"^^xsd:date .

inst:Project_Construction a cim-f:ConstructionProcess ;
    rdfs:label "5F病房层施工安装过程"@zh-CN ;
    cim-f:processStageCode "CONST" ;
    cim-f:processStartDate "2026-08-01"^^xsd:date ;
    cim-f:processEndDate   "2027-03-31"^^xsd:date ;
    cim-f:hasMilestone inst:Milestone_ConstructionComplete .

inst:Milestone_ConstructionComplete a cim-f:ConstructionCompletionMilestone ;
    rdfs:label "竣工验收里程碑"@zh-CN .

inst:Project_Commissioning a cim-f:CommissioningProcess ;
    rdfs:label "5F病房层调试验收过程"@zh-CN ;
    cim-f:processStageCode "COMM" ;
    cim-f:processStartDate "2027-04-01"^^xsd:date ;
    cim-f:processEndDate   "2027-06-30"^^xsd:date ;
    cim-f:hasMilestone inst:Milestone_Handover .

inst:Milestone_Handover a cim-f:HandoverMilestone ;
    rdfs:label "PIM→AIM 移交里程碑"@zh-CN .

inst:Project_MedGasValidation a cim-f:MedicalGasValidationProcess ;
    rdfs:label "5F病房层医用气体系统验证过程"@zh-CN ;
    cim-f:processStageCode "MEDGAS-VAL" ;
    cim-f:processStartDate "2027-04-15"^^xsd:date .

inst:Project_CleanroomQual a cim-f:CleanroomQualificationProcess ;
    rdfs:label "5F病房层洁净室资质验收过程"@zh-CN ;
    cim-f:processStageCode "CR-QUAL" ;
    cim-f:processStartDate "2027-05-01"^^xsd:date .

# ── 时序链 ─────────────────────────────────────────────────────────────────────
inst:Project_ConceptualDesign cim-f:temporallyPrecedes inst:Project_SchematicDesign .
inst:Project_SchematicDesign  cim-f:temporallyPrecedes inst:Project_DetailedDesign .
inst:Project_DetailedDesign   cim-f:temporallyPrecedes inst:Project_Tendering .
inst:Project_Tendering        cim-f:temporallyPrecedes inst:Project_Construction .
inst:Project_Construction     cim-f:temporallyPrecedes inst:Project_Commissioning .
inst:Project_Commissioning    cim-f:temporallyPrecedes inst:Project_MedGasValidation .
inst:Project_Commissioning    cim-f:temporallyPrecedes inst:Project_CleanroomQual .

# ── 信息制品 ───────────────────────────────────────────────────────────────────
inst:SchematicIFCModel a cim-f:DesignModel ;
    rdfs:label "5F病房层初步设计 IFC 模型"@zh-CN ;
    cim-f:isoLoD "LOD200" ;
    cim-f:producedBy inst:Project_SchematicDesign .

inst:DetailedIFCModel a cim-f:DesignModel ;
    rdfs:label "5F病房层施工图 IFC 模型"@zh-CN ;
    cim-f:isoLoD "LOD300" ;
    cim-f:producedBy inst:Project_DetailedDesign .

# =============================================================================
# END OF SCENARIO — 5F Ward Floor v2.0 (简化版)
# =============================================================================
