# =============================================================================
# 电气系统 (Electrical System)
# =============================================================================

# ── 应急电源 (Emergency Power) ────────────────────────────────────────────────
inst:DieselGenerator a cim-equip:DieselGenerator ;
    rdfs:label "柴油发电机 DG-01"@zh-CN ;
    cim-d:designTag "DG-01" ;
    cim-d:ratedCapacity "400.0"^^xsd:decimal ;
    cim-d:redundancyStrategy "N+1" ;
    cim-c:hasConnectionPoint inst:GEN_out .

inst:GEN_out a cim-c:OutletConnectionPoint ;
    cim-c:hasMedium cim-med:EmergencyPower ;
    cim-c:connectsTo inst:FP_EPWR_GEN_UPS .

inst:UPS_OR_Wing a cim-equip:UPS ;
    rdfs:label "手术部 UPS UPS-OR-01"@zh-CN ;
    cim-d:designTag "UPS-OR-01" ;
    cim-d:ratedCapacity "80.0"^^xsd:decimal ;
    cim-d:redundancyStrategy "N+1" ;
    cim-c:hasConnectionPoint inst:UPS_in ;
    cim-c:hasConnectionPoint inst:UPS_out .

inst:UPS_in a cim-c:InletConnectionPoint ;
    cim-c:hasMedium cim-med:EmergencyPower ;
    cim-c:connectsTo inst:FP_EPWR_GEN_UPS .

inst:UPS_out a cim-c:OutletConnectionPoint ;
    cim-c:hasMedium cim-med:EmergencyPower ;
    cim-c:connectsTo inst:FP_EPWR_UPS_DIST .

inst:FP_EPWR_GEN_UPS a cim-flow:EmergencyPowerFlow ;
    cim-c:hasMedium cim-med:EmergencyPower .

# ── 应急电源分配母线 (UPS → 三间 OR) ─────────────────────────────────────────
inst:FP_EPWR_UPS_DIST a cim-flow:EmergencyPowerFlow ;
    cim-c:hasMedium cim-med:EmergencyPower ;
    cim-c:connectsTo inst:FP_EPWR_UPS_IT01 ;
    cim-c:connectsTo inst:FP_EPWR_UPS_IT02 ;
    cim-c:connectsTo inst:FP_EPWR_UPS_IT03 .

# ── IT 隔离电源面板 — OR-01 ───────────────────────────────────────────────────
inst:ITPanel_OR01 a cim-equip:IsolatedPowerSystem ;
    rdfs:label "OR-01 IT隔离电源 ITP-OR-01"@zh-CN ;
    cim-d:designTag "ITP-OR-01" ;
    cim-space:locatedIn inst:OR_01 ;
    cim-c:hasConnectionPoint inst:IT01_in .

inst:IT01_in a cim-c:InletConnectionPoint ;
    cim-c:hasMedium cim-med:EmergencyPower ;
    cim-c:connectsTo inst:FP_EPWR_UPS_IT01 .

inst:FP_EPWR_UPS_IT01 a cim-flow:EmergencyPowerFlow ;
    cim-c:hasMedium cim-med:EmergencyPower .

# ── IT 隔离电源面板 — OR-02 ───────────────────────────────────────────────────
inst:ITPanel_OR02 a cim-equip:IsolatedPowerSystem ;
    rdfs:label "OR-02 IT隔离电源 ITP-OR-02"@zh-CN ;
    cim-d:designTag "ITP-OR-02" ;
    cim-space:locatedIn inst:OR_02 ;
    cim-c:hasConnectionPoint inst:IT02_in .

inst:IT02_in a cim-c:InletConnectionPoint ;
    cim-c:hasMedium cim-med:EmergencyPower ;
    cim-c:connectsTo inst:FP_EPWR_UPS_IT02 .

inst:FP_EPWR_UPS_IT02 a cim-flow:EmergencyPowerFlow ;
    cim-c:hasMedium cim-med:EmergencyPower .

# ── IT 隔离电源面板 — OR-03 ───────────────────────────────────────────────────
inst:ITPanel_OR03 a cim-equip:IsolatedPowerSystem ;
    rdfs:label "OR-03 IT隔离电源 ITP-OR-03"@zh-CN ;
    cim-d:designTag "ITP-OR-03" ;
    cim-space:locatedIn inst:OR_03 ;
    cim-c:hasConnectionPoint inst:IT03_in .

inst:IT03_in a cim-c:InletConnectionPoint ;
    cim-c:hasMedium cim-med:EmergencyPower ;
    cim-c:connectsTo inst:FP_EPWR_UPS_IT03 .

inst:FP_EPWR_UPS_IT03 a cim-flow:EmergencyPowerFlow ;
