# --- Zone 1F-GENERAL: 6 detectors ---

fas:SD-1F-GEN-01 a cim-fas:SmokeDetector ;
    rdfs:label "Smoke Detector 1F-GEN-01 (Reception)"@en ;
    cim:hasEquipmentID "SD-1F-GEN-01" ;
    cim-fas:hasFASZoneID "Z1F-GEN" ;
    cim-fas:hasDetectionState "NORMAL" ;
    cim-fas:hasProtectionRadius "6.7"^^xsd:decimal ;
    cim-fas:hasInstallationHeight "3.0"^^xsd:decimal ;
    cim-fas:linkedToPanel fas:FACU-1F-01 ;
    cim-fas:hasAlarmZone fas:ZONE-1F-GENERAL ;
