# =============================================================================
# CIM ABox — NBU Medical Clinic FAS (Fire Alarm System) Instance Data
#
# Source : layer4_fas_security.ttl TBox + NBU Medical Clinic layout
# Ontology: CIM v4.0 FAS Security Layer
# Date   : 2026-05-10
# Count  : ~62 device instances across 5 fire alarm zones
# =============================================================================

@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .

@prefix cim:       <https://cim.medical/ontology/v3.4#> .
@prefix cim-equip: <https://cim.medical/ontology/v3.4/equipment#> .
@prefix cim-space: <https://cim.medical/ontology/v3.4/space#> .
@prefix cim-fas:   <https://cim.medical/ontology/v4.0/fas#> .
@prefix cim-d:     <https://cim.medical/ontology/v4.0/design#> .

@prefix inst:      <https://cim.medical/instance/nbu_medical_clinic/> .
@prefix fas:       <https://cim.medical/instance/fas/> .

# ===========================================================================
# FIRE ALARM CONTROL UNITS (FACU) — 3 panels
# ===========================================================================

fas:FACU-1F-01 a cim-fas:FireAlarmControlUnit ;
    rdfs:label "First Floor Fire Alarm Control Unit"@en ,
               "一层火灾报警控制器"@zh ;
    cim:hasEquipmentID "FACU-1F-01" ;
    cim-fas:hasFASZoneID "Z1F-ALL" ;
    cim-fas:coverageArea inst:FLOOR-First_Floor .

fas:FACU-2F-01 a cim-fas:FireAlarmControlUnit ;
    rdfs:label "Second Floor Fire Alarm Control Unit"@en ,
               "二层火灾报警控制器"@zh ;
    cim:hasEquipmentID "FACU-2F-01" ;
    cim-fas:hasFASZoneID "Z2F-ALL" ;
    cim-fas:coverageArea inst:FLOOR-Second_Floor .

fas:FACU-RF-01 a cim-fas:FireAlarmControlUnit ;
    rdfs:label "Roof Mechanical Fire Alarm Control Unit"@en ,
               "屋顶机房火灾报警控制器"@zh ;
    cim:hasEquipmentID "FACU-RF-01" ;
    cim-fas:hasFASZoneID "ZRF-ALL" ;
    cim-fas:coverageArea inst:FLOOR-Roof_-_Mech .

# ===========================================================================
# FIRE ALARM ZONES — 5 zones
# ===========================================================================

fas:ZONE-1F-GENERAL a cim-fas:FireAlarmZone ;
    rdfs:label "1F General Zone"@en ,
               "一层一般区域"@zh ;
    cim-fas:hasZoneNumber 1 .

fas:ZONE-1F-MECH a cim-fas:FireAlarmZone ;
    rdfs:label "1F Mechanical Zone"@en ,
               "一层机房区域"@zh ;
    cim-fas:hasZoneNumber 2 .

fas:ZONE-2F-GENERAL a cim-fas:FireAlarmZone ;
    rdfs:label "2F General Zone"@en ,
               "二层一般区域"@zh ;
    cim-fas:hasZoneNumber 3 .

fas:ZONE-2F-OR a cim-fas:FireAlarmZone ;
    rdfs:label "2F Operating Room Zone"@en ,
               "二层手术室区域"@zh ;
    cim-fas:hasZoneNumber 4 .

fas:ZONE-RF-MECH a cim-fas:FireAlarmZone ;
    rdfs:label "Roof Mechanical Zone"@en ,
               "屋顶机房区域"@zh ;
    cim-fas:hasZoneNumber 5 .

