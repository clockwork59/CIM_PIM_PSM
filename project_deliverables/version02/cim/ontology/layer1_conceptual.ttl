cim-space:infectionRiskLevel
    a owl:DatatypeProperty ;
    rdfs:domain cim-space:Room ;
    rdfs:range xsd:string ;
    rdfs:label "infection risk level"@en ; rdfs:label "感染风险等级"@zh-CN ;
    skos:note "E类(极高)-A类(低), 依据 GB 15982-2012"@zh-CN .

# =============================================================================
# PART F — 流动模型 (Flow Model)
#
# 设计说明:
#   流动层是 CIM 概念模型的核心纽带，将三个子系统串联成完整拓扑:
#     ① 设备/管网构件 (cim-equip:)  ——→ 连接点 (cim-c:ConnectionPoint)
#     ② 连接点         ←——→         流路 (cim-flow:FlowPath)
#     ③ 流路                  携带   介质 (cim-med:Medium)
#
#   三类流动对应建筑技术系统的三种本质:
#     - MassFlow      (物质流): 流体、医用气体、电流载体
#     - EnergyFlow    (能量流): 热能、电能（以功率/能量为载荷）
#     - InformationFlow (信息流): 控制信号、BAS 数据
#
#   与 ASHRAE 223P 的对应:
#     FlowPath → s223:Connection / s223:SystemsConnection
#     FlowPath.hasMedium → s223:hasMedium
#     FlowSegment → s223:ConnectionPoint（管段是连接点的物理实现）
#
# Version : 4.0.0  |  2026-05-06
# =============================================================================

# ── 根类 ─────────────────────────────────────────────────────────────────────
cim-flow:FlowPath
    a owl:Class ;
    rdfs:label "Flow Path"@en ; rdfs:label "流动路径"@zh-CN ;
    rdfs:comment """
        两个连接点之间的有向/无向流动通道抽象。
        一条 FlowPath 连接 sourcePoint → sinkPoint，
        并携带 (hasMedium) 至少一种介质。
    """@zh-CN ;
    skos:note "ASHRAE 223P: s223:Connection / s223:SystemsConnection"@en .

# ── 三类流动 ─────────────────────────────────────────────────────────────────
cim-flow:MassFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:FlowPath ;
    rdfs:label "Mass Flow"@en ; rdfs:label "物质流"@zh-CN ;
    rdfs:comment "携带可量化质量/体积流量的流动，如管道内流体、医用气体管路"@zh-CN .

cim-flow:EnergyFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:FlowPath ;
    rdfs:label "Energy Flow"@en ; rdfs:label "能量流"@zh-CN ;
    rdfs:comment "以热量或电功率为传输载荷的流动，描述系统间的能量交换"@zh-CN .

cim-flow:InformationFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:FlowPath ;
    rdfs:label "Information Flow"@en ; rdfs:label "信息流"@zh-CN ;
    rdfs:comment "携带控制信号、传感数据或状态反馈的逻辑通道"@zh-CN .

# =============================================================================
# F.1 — 物质流细分 (MassFlow Subtypes)
# =============================================================================

# ── 空气流动 ─────────────────────────────────────────────────────────────────
cim-flow:AirFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:MassFlow ;
    rdfs:label "Air Flow"@en ; rdfs:label "气流"@zh-CN ;
    rdfs:comment "空调/通风管道中的空气流动，介质为 cim-med:Air 子类"@zh-CN .

cim-flow:SupplyAirFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:AirFlow ;
    rdfs:label "Supply Air Flow"@en ; rdfs:label "送风气流"@zh-CN ;
    cim-c:hasMedium cim-med:SupplyAir .

cim-flow:ReturnAirFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:AirFlow ;
    rdfs:label "Return Air Flow"@en ; rdfs:label "回风气流"@zh-CN ;
    cim-c:hasMedium cim-med:ReturnAir .

cim-flow:ExhaustAirFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:AirFlow ;
    rdfs:label "Exhaust Air Flow"@en ; rdfs:label "排风气流"@zh-CN ;
    cim-c:hasMedium cim-med:ExhaustAir .

cim-flow:OutdoorAirFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:AirFlow ;
    rdfs:label "Outdoor Air Flow"@en ; rdfs:label "新风气流"@zh-CN ;
    cim-c:hasMedium cim-med:OutdoorAir .

# ── 水系统流动 ────────────────────────────────────────────────────────────────
cim-flow:WaterFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:MassFlow ;
    rdfs:label "Water Flow"@en ; rdfs:label "水流"@zh-CN ;
    rdfs:comment "HVAC 水系统或给排水管路中的液态水流动"@zh-CN .

cim-flow:ChilledWaterFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:WaterFlow ;
    rdfs:label "Chilled Water Flow"@en ; rdfs:label "冷冻水流"@zh-CN ;
    cim-c:hasMedium cim-med:ChilledWater .

cim-flow:HotWaterFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:WaterFlow ;
    rdfs:label "Hot Water Flow"@en ; rdfs:label "热水流"@zh-CN ;
    cim-c:hasMedium cim-med:HotWater .

cim-flow:CondenserWaterFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:WaterFlow ;
    rdfs:label "Condenser Water Flow"@en ; rdfs:label "冷却水流"@zh-CN ;
    cim-c:hasMedium cim-med:CondenserWater .

cim-flow:DomesticWaterFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:WaterFlow ;
    rdfs:label "Domestic Water Flow"@en ; rdfs:label "生活用水流"@zh-CN ;
    cim-c:hasMedium cim-med:DomesticColdWater .

cim-flow:DrainageFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:WaterFlow ;
    rdfs:label "Drainage Flow"@en ; rdfs:label "排水流"@zh-CN ;
    rdfs:comment "污水/废水重力或压力排放，通常单向，无回路"@zh-CN .

# ── 医用气体流动 ──────────────────────────────────────────────────────────────
cim-flow:MedicalGasFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:MassFlow ;
    rdfs:label "Medical Gas Flow"@en ; rdfs:label "医用气体流"@zh-CN ;
    rdfs:comment "医院医用气体管路中的气体流动，介质为 cim-med:MedicalGas 子类"@zh-CN .

cim-flow:OxygenFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:MedicalGasFlow ;
    rdfs:label "Oxygen Flow"@en ; rdfs:label "氧气流"@zh-CN ;
    cim-c:hasMedium cim-med:Oxygen .

cim-flow:MedicalVacuumFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:MedicalGasFlow ;
    rdfs:label "Medical Vacuum Flow"@en ; rdfs:label "医用负压流"@zh-CN ;
    cim-c:hasMedium cim-med:MedicalVacuum .

cim-flow:MedicalAirFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:MedicalGasFlow ;
    rdfs:label "Medical Air Flow"@en ; rdfs:label "医用压缩空气流"@zh-CN ;
    cim-c:hasMedium cim-med:MedicalAir .

cim-flow:NitrousOxideFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:MedicalGasFlow ;
    rdfs:label "Nitrous Oxide Flow"@en ; rdfs:label "氧化亚氮流"@zh-CN ;
