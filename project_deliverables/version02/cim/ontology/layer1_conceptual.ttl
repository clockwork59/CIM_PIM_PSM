# =============================================================================
# CIM Layer 1 — Conceptual Ontology
# 医疗建筑统一领域模型 · 概念本体
#
# 设计原则:
#   - 融合 Brick Schema (~600类) 和 ASHRAE 223P (~400类) 的核心语义
#   - 对 ISO 19650 信息管理框架中"概念本体"层的实现
#   - 平台无关、标准中立的领域概念定义
#
# Version : 4.0.0
# Date    : 2026-05-06
# Extends : CIM M1 (v3.4) ontology_skeleton.ttl
# =============================================================================

@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .

# ── CIM 核心命名空间 (向后兼容 v3.4) ──────────────────────────────────────
@prefix cim:      <https://cim.medical/ontology/v3.4#> .
@prefix cim-equip: <https://cim.medical/ontology/v3.4/equipment#> .
@prefix cim-space: <https://cim.medical/ontology/v3.4/space#> .
@prefix cim-ctrl:  <https://cim.medical/ontology/v3.4/control#> .
@prefix cim-flow:  <https://cim.medical/ontology/v3.4/flow#> .

# ── 新增概念层命名空间 ─────────────────────────────────────────────────────
@prefix cim-c:    <https://cim.medical/ontology/v4.0/conceptual#> .
@prefix cim-med:  <https://cim.medical/ontology/v4.0/medium#> .
@prefix cim-pt:   <https://cim.medical/ontology/v4.0/point#> .

<https://cim.medical/ontology/v4.0/conceptual>
    a owl:Ontology ;
    rdfs:label "CIM Conceptual Ontology — Layer 1"@en ;
    rdfs:label "CIM概念本体 — 第1层"@zh-CN ;
    rdfs:comment """
        ISO 19650 信息管理框架中的概念本体层。
        融合 Brick Schema 和 ASHRAE 223P 的核心语义，
        定义医疗建筑技术系统的平台无关领域概念。
    """@zh-CN ;
    owl:versionInfo "4.0.0" ;
    owl:imports <https://cim.medical/ontology/v3.4> .

# =============================================================================
# PART A — 流体介质层级 (Medium Hierarchy)
# 来源: ASHRAE 223P s223:Medium 体系
# 说明: 这是 M1 最大的缺口之一，系统拓扑依赖介质类型区分
# =============================================================================

cim-med:Medium
    a owl:Class ;
    rdfs:label "Medium"@en ;
    rdfs:label "介质"@zh-CN ;
    rdfs:comment "流经分配网络的物质或能量载体的抽象基类"@zh-CN ;
    skos:note "ASHRAE 223P: s223:Medium"@en .

cim-med:FluidMedium
    a owl:Class ;
    rdfs:subClassOf cim-med:Medium ;
    rdfs:label "Fluid Medium"@en ;
    rdfs:label "流体介质"@zh-CN .

cim-med:ElectricalMedium
    a owl:Class ;
    rdfs:subClassOf cim-med:Medium ;
    rdfs:label "Electrical Medium"@en ;
    rdfs:label "电能介质"@zh-CN .

cim-med:InformationMedium
    a owl:Class ;
    rdfs:subClassOf cim-med:Medium ;
    rdfs:label "Information Medium"@en ;
    rdfs:label "信息介质"@zh-CN .

# ── 空气介质 ────────────────────────────────────────────────────────────────
cim-med:Air
    a owl:Class ;
    rdfs:subClassOf cim-med:FluidMedium ;
    rdfs:label "Air"@en ; rdfs:label "空气"@zh-CN .

cim-med:SupplyAir
    a owl:Class ;
    rdfs:subClassOf cim-med:Air ;
    rdfs:label "Supply Air"@en ; rdfs:label "送风"@zh-CN ;
    skos:note "典型温度 14-18°C，正压送入空调区域"@zh-CN .

cim-med:ReturnAir
    a owl:Class ;
    rdfs:subClassOf cim-med:Air ;
    rdfs:label "Return Air"@en ; rdfs:label "回风"@zh-CN .

cim-med:ExhaustAir
    a owl:Class ;
    rdfs:subClassOf cim-med:Air ;
    rdfs:label "Exhaust Air"@en ; rdfs:label "排风"@zh-CN .

cim-med:OutdoorAir
    a owl:Class ;
    rdfs:subClassOf cim-med:Air ;
    rdfs:label "Outdoor Air"@en ; rdfs:label "新风"@zh-CN .

cim-med:MixedAir
    a owl:Class ;
    rdfs:subClassOf cim-med:Air ;
    rdfs:label "Mixed Air"@en ; rdfs:label "混合风（新回风混合）"@zh-CN .

# ── 水系统介质 ───────────────────────────────────────────────────────────────
cim-med:Water
    a owl:Class ;
    rdfs:subClassOf cim-med:FluidMedium ;
    rdfs:label "Water"@en ; rdfs:label "水"@zh-CN .

cim-med:ChilledWater
    a owl:Class ;
    rdfs:subClassOf cim-med:Water ;
    rdfs:label "Chilled Water"@en ; rdfs:label "冷冻水"@zh-CN ;
    skos:note "典型供水温度 7°C，回水温度 12°C"@zh-CN .

cim-med:HotWater
    a owl:Class ;
    rdfs:subClassOf cim-med:Water ;
    rdfs:label "Hot Water"@en ; rdfs:label "热水"@zh-CN ;
    skos:note "典型供水温度 60°C，回水温度 50°C"@zh-CN .

cim-med:CondenserWater
    a owl:Class ;
    rdfs:subClassOf cim-med:Water ;
    rdfs:label "Condenser Water"@en ; rdfs:label "冷却水"@zh-CN ;
    skos:note "典型供水温度 32°C，回水温度 37°C"@zh-CN .

cim-med:DomesticHotWater
    a owl:Class ;
    rdfs:subClassOf cim-med:Water ;
    rdfs:label "Domestic Hot Water"@en ; rdfs:label "生活热水"@zh-CN ;
    skos:note "卫生热水系统，≥55°C 防军团菌"@zh-CN .

cim-med:DomesticColdWater
    a owl:Class ;
    rdfs:subClassOf cim-med:Water ;
    rdfs:label "Domestic Cold Water"@en ; rdfs:label "生活冷水"@zh-CN .

cim-med:SanitaryDrainage
    a owl:Class ;
    rdfs:subClassOf cim-med:Water ;
    rdfs:label "Sanitary Drainage"@en ; rdfs:label "污/废水"@zh-CN .

cim-med:SteamCondensate
    a owl:Class ;
    rdfs:subClassOf cim-med:Water ;
    rdfs:label "Steam Condensate"@en ; rdfs:label "蒸汽冷凝水"@zh-CN .

# ── 医用气体 ─────────────────────────────────────────────────────────────────
cim-med:MedicalGas
    a owl:Class ;
    rdfs:subClassOf cim-med:FluidMedium ;
    rdfs:label "Medical Gas"@en ; rdfs:label "医用气体"@zh-CN ;
    skos:note "符合 WS 435 及 ISO 7396 标准的管道气体"@zh-CN .

cim-med:Oxygen
    a owl:Class ;
    rdfs:subClassOf cim-med:MedicalGas ;
    rdfs:label "Oxygen (O₂)"@en ; rdfs:label "医用氧气"@zh-CN ;
    cim:reliabilityLevel "LIFE_SAFETY"^^xsd:string ;
    skos:note "管道供氧压力 0.4–0.5 MPa，纯度 ≥99.5%"@zh-CN .

cim-med:MedicalVacuum
    a owl:Class ;
    rdfs:subClassOf cim-med:MedicalGas ;
    rdfs:label "Medical Vacuum (VAC)"@en ; rdfs:label "医用负压（吸引）"@zh-CN ;
    cim:reliabilityLevel "LIFE_SAFETY"^^xsd:string ;
    skos:note "管道负压 −0.04 MPa（相对压力）"@zh-CN .

cim-med:MedicalCompressedAir
    a owl:Class ;
    rdfs:subClassOf cim-med:MedicalGas ;
    rdfs:label "Medical Compressed Air (CAIR)"@en ; rdfs:label "医用压缩空气"@zh-CN ;
    skos:note "压力 0.4–0.5 MPa，露点 ≤−3°C"@zh-CN .

cim-med:NitrousOxide
    a owl:Class ;
    rdfs:subClassOf cim-med:MedicalGas ;
    rdfs:label "Nitrous Oxide (N₂O)"@en ; rdfs:label "氧化亚氮（笑气）"@zh-CN .

cim-med:Nitrogen
    a owl:Class ;
    rdfs:subClassOf cim-med:MedicalGas ;
    rdfs:label "Nitrogen (N₂)"@en ; rdfs:label "医用氮气（手术气动工具）"@zh-CN .

cim-med:CarbonDioxide
    a owl:Class ;
    rdfs:subClassOf cim-med:MedicalGas ;
    rdfs:label "Carbon Dioxide (CO₂)"@en ; rdfs:label "医用二氧化碳（腔镜手术充气）"@zh-CN .

# ── 电能介质 ─────────────────────────────────────────────────────────────────
cim-med:ACPower
    a owl:Class ;
    rdfs:subClassOf cim-med:ElectricalMedium ;
    rdfs:label "AC Power"@en ; rdfs:label "交流电"@zh-CN .

cim-med:DCPower
    a owl:Class ;
    rdfs:subClassOf cim-med:ElectricalMedium ;
    rdfs:label "DC Power"@en ; rdfs:label "直流电"@zh-CN .

cim-med:EmergencyPower
    a owl:Class ;
    rdfs:subClassOf cim-med:ACPower ;
    rdfs:label "Emergency Power"@en ; rdfs:label "应急电源"@zh-CN ;
    cim:reliabilityLevel "LIFE_SAFETY"^^xsd:string ;
    skos:note "切换时间 ≤0.5s（UPS）或 ≤10s（发电机）"@zh-CN .

# =============================================================================
# PART B — 连接点模型 (ConnectionPoint)
# 来源: ASHRAE 223P s223:ConnectionPoint
# 说明: M1 缺失此模型；是流体网络拓扑的基础
# =============================================================================

cim-c:ConnectionPoint
    a owl:Class ;
    rdfs:label "Connection Point"@en ;
    rdfs:label "连接点"@zh-CN ;
    rdfs:comment "设备或系统边界上的流体/电气/信息连接接口"@zh-CN ;
    skos:note "ASHRAE 223P: s223:ConnectionPoint"@en .

cim-c:InletConnectionPoint
    a owl:Class ;
    rdfs:subClassOf cim-c:ConnectionPoint ;
    rdfs:label "Inlet Connection Point"@en ; rdfs:label "入口连接点"@zh-CN .

cim-c:OutletConnectionPoint
    a owl:Class ;
    rdfs:subClassOf cim-c:ConnectionPoint ;
    rdfs:label "Outlet Connection Point"@en ; rdfs:label "出口连接点"@zh-CN .

cim-c:BidirectionalConnectionPoint
    a owl:Class ;
    rdfs:subClassOf cim-c:ConnectionPoint ;
    rdfs:label "Bidirectional Connection Point"@en ;
    rdfs:label "双向连接点"@zh-CN ;
    skos:note "用于可逆流向场景（如板换、蓄冷罐）"@zh-CN .

# ── ConnectionPoint 属性 ─────────────────────────────────────────────────────
cim-c:hasMedium
    a owl:ObjectProperty ;
    rdfs:domain cim-c:ConnectionPoint ;
    rdfs:range cim-med:Medium ;
    rdfs:label "has medium"@en ; rdfs:label "携带介质"@zh-CN ;
    skos:note "ASHRAE 223P: s223:hasMedium"@en .

cim-c:connectsTo
    a owl:ObjectProperty ;
    rdfs:domain cim-c:ConnectionPoint ;
    rdfs:range cim-c:ConnectionPoint ;
    rdfs:label "connects to"@en ; rdfs:label "连接至"@zh-CN ;
    skos:note "ASHRAE 223P: s223:cnx"@en .

cim-c:hasConnectionPoint
    a owl:ObjectProperty ;
    rdfs:domain cim-equip:Equipment ;
    rdfs:range cim-c:ConnectionPoint ;
    rdfs:label "has connection point"@en ; rdfs:label "具有连接点"@zh-CN .

# =============================================================================
# PART C — 点层级 (Point Hierarchy)
# 来源: Brick Schema brick:Point 体系
# 说明: M1 只有粗粒度传感器类，缺少 Command/Setpoint/Status/Parameter
# =============================================================================

cim-pt:Point
    a owl:Class ;
    rdfs:label "Point"@en ;
    rdfs:label "数据点"@zh-CN ;
    rdfs:comment "关联物理实体的可测量/可控制的最小数据单元"@zh-CN ;
    skos:note "Brick Schema: brick:Point"@en .

# ── 传感器点 (Sensor Points) ────────────────────────────────────────────────
cim-pt:SensorPoint
    a owl:Class ;
    rdfs:subClassOf cim-pt:Point ;
    rdfs:label "Sensor Point"@en ; rdfs:label "传感点（测量值）"@zh-CN .

cim-pt:TemperaturePoint
    a owl:Class ; rdfs:subClassOf cim-pt:SensorPoint ;
    rdfs:label "Temperature Point"@en ; rdfs:label "温度点"@zh-CN .

cim-pt:SupplyAirTemperaturePoint
    a owl:Class ; rdfs:subClassOf cim-pt:TemperaturePoint ;
    rdfs:label "Supply Air Temperature"@en ; rdfs:label "送风温度"@zh-CN ;
    skos:note "Brick: brick:Supply_Air_Temperature_Sensor"@en .

cim-pt:ReturnAirTemperaturePoint
    a owl:Class ; rdfs:subClassOf cim-pt:TemperaturePoint ;
    rdfs:label "Return Air Temperature"@en ; rdfs:label "回风温度"@zh-CN .

cim-pt:ZoneAirTemperaturePoint
    a owl:Class ; rdfs:subClassOf cim-pt:TemperaturePoint ;
    rdfs:label "Zone Air Temperature"@en ; rdfs:label "区域温度"@zh-CN .

cim-pt:ChilledWaterSupplyTemperaturePoint
    a owl:Class ; rdfs:subClassOf cim-pt:TemperaturePoint ;
    rdfs:label "Chilled Water Supply Temperature"@en ; rdfs:label "冷冻水供水温度"@zh-CN .

cim-pt:HumidityPoint
    a owl:Class ; rdfs:subClassOf cim-pt:SensorPoint ;
    rdfs:label "Humidity Point"@en ; rdfs:label "湿度点"@zh-CN .

cim-pt:ZoneAirHumidityPoint
    a owl:Class ; rdfs:subClassOf cim-pt:HumidityPoint ;
    rdfs:label "Zone Air Humidity"@en ; rdfs:label "区域相对湿度"@zh-CN .

cim-pt:PressurePoint
    a owl:Class ; rdfs:subClassOf cim-pt:SensorPoint ;
    rdfs:label "Pressure Point"@en ; rdfs:label "压力/压差点"@zh-CN .

cim-pt:DifferentialPressurePoint
    a owl:Class ; rdfs:subClassOf cim-pt:PressurePoint ;
    rdfs:label "Differential Pressure"@en ; rdfs:label "压差"@zh-CN .

cim-pt:StaticPressurePoint
    a owl:Class ; rdfs:subClassOf cim-pt:PressurePoint ;
    rdfs:label "Static Pressure"@en ; rdfs:label "静压"@zh-CN .

cim-pt:RoomPressureDifferentialPoint
    a owl:Class ; rdfs:subClassOf cim-pt:DifferentialPressurePoint ;
    rdfs:label "Room Pressure Differential"@en ; rdfs:label "房间压差（正/负压监控）"@zh-CN ;
    cim:reliabilityLevel "LIFE_SAFETY"^^xsd:string .

cim-pt:MedicalGasPressurePoint
    a owl:Class ; rdfs:subClassOf cim-pt:PressurePoint ;
    rdfs:label "Medical Gas Pressure"@en ; rdfs:label "医用气体压力"@zh-CN ;
    cim:reliabilityLevel "LIFE_SAFETY"^^xsd:string .

cim-pt:FlowPoint
    a owl:Class ; rdfs:subClassOf cim-pt:SensorPoint ;
    rdfs:label "Flow Point"@en ; rdfs:label "流量点"@zh-CN .

cim-pt:AirFlowPoint
    a owl:Class ; rdfs:subClassOf cim-pt:FlowPoint ;
    rdfs:label "Air Flow"@en ; rdfs:label "风量"@zh-CN .

cim-pt:WaterFlowPoint
    a owl:Class ; rdfs:subClassOf cim-pt:FlowPoint ;
    rdfs:label "Water Flow"@en ; rdfs:label "水流量"@zh-CN .

cim-pt:CO2Point
    a owl:Class ; rdfs:subClassOf cim-pt:SensorPoint ;
    rdfs:label "CO₂ Concentration"@en ; rdfs:label "二氧化碳浓度"@zh-CN .

cim-pt:PM25Point
    a owl:Class ; rdfs:subClassOf cim-pt:SensorPoint ;
    rdfs:label "PM2.5 Concentration"@en ; rdfs:label "PM2.5浓度"@zh-CN .

cim-pt:VOCPoint
    a owl:Class ; rdfs:subClassOf cim-pt:SensorPoint ;
    rdfs:label "VOC Concentration"@en ; rdfs:label "挥发性有机物浓度"@zh-CN .

cim-pt:OccupancyPoint
    a owl:Class ; rdfs:subClassOf cim-pt:SensorPoint ;
    rdfs:label "Occupancy"@en ; rdfs:label "占用状态"@zh-CN .

cim-pt:PowerPoint
    a owl:Class ; rdfs:subClassOf cim-pt:SensorPoint ;
    rdfs:label "Power"@en ; rdfs:label "电功率"@zh-CN .

cim-pt:EnergyPoint
    a owl:Class ; rdfs:subClassOf cim-pt:SensorPoint ;
    rdfs:label "Energy"@en ; rdfs:label "电能（累计）"@zh-CN .

cim-pt:LevelPoint
    a owl:Class ; rdfs:subClassOf cim-pt:SensorPoint ;
    rdfs:label "Level"@en ; rdfs:label "液位"@zh-CN .

cim-pt:VibrationPoint
    a owl:Class ; rdfs:subClassOf cim-pt:SensorPoint ;
    rdfs:label "Vibration"@en ; rdfs:label "振动"@zh-CN ;
    skos:note "用于轴承状态监测（预测性维护）"@zh-CN .

# ── 命令点 (Command Points) ─────────────────────────────────────────────────
cim-pt:CommandPoint
    a owl:Class ;
    rdfs:subClassOf cim-pt:Point ;
    rdfs:label "Command Point"@en ; rdfs:label "命令点（控制输出）"@zh-CN ;
    skos:note "Brick: brick:Command"@en .

cim-pt:OnOffCommand
    a owl:Class ; rdfs:subClassOf cim-pt:CommandPoint ;
    rdfs:label "On/Off Command"@en ; rdfs:label "启停命令"@zh-CN .

cim-pt:SpeedCommand
    a owl:Class ; rdfs:subClassOf cim-pt:CommandPoint ;
    rdfs:label "Speed Command"@en ; rdfs:label "转速/频率命令"@zh-CN .

cim-pt:PositionCommand
    a owl:Class ; rdfs:subClassOf cim-pt:CommandPoint ;
    rdfs:label "Position Command"@en ; rdfs:label "阀门/风门开度命令"@zh-CN .

# ── 设定点 (Setpoints) ───────────────────────────────────────────────────────
cim-pt:SetpointPoint
    a owl:Class ;
    rdfs:subClassOf cim-pt:Point ;
    rdfs:label "Setpoint"@en ; rdfs:label "设定点"@zh-CN ;
    skos:note "Brick: brick:Setpoint"@en .

cim-pt:TemperatureSetpoint
    a owl:Class ; rdfs:subClassOf cim-pt:SetpointPoint ;
    rdfs:label "Temperature Setpoint"@en ; rdfs:label "温度设定值"@zh-CN .

cim-pt:HumiditySetpoint
    a owl:Class ; rdfs:subClassOf cim-pt:SetpointPoint ;
    rdfs:label "Humidity Setpoint"@en ; rdfs:label "湿度设定值"@zh-CN .

cim-pt:PressureSetpoint
    a owl:Class ; rdfs:subClassOf cim-pt:SetpointPoint ;
    rdfs:label "Pressure Setpoint"@en ; rdfs:label "压力/压差设定值"@zh-CN .

cim-pt:FlowSetpoint
    a owl:Class ; rdfs:subClassOf cim-pt:SetpointPoint ;
    rdfs:label "Flow Setpoint"@en ; rdfs:label "流量设定值"@zh-CN .

# ── 状态点 (Status Points) ───────────────────────────────────────────────────
cim-pt:StatusPoint
    a owl:Class ;
    rdfs:subClassOf cim-pt:Point ;
    rdfs:label "Status Point"@en ; rdfs:label "状态点"@zh-CN ;
    skos:note "Brick: brick:Status"@en .

cim-pt:RunStatus
    a owl:Class ; rdfs:subClassOf cim-pt:StatusPoint ;
    rdfs:label "Run Status"@en ; rdfs:label "运行状态"@zh-CN .

cim-pt:FaultStatus
    a owl:Class ; rdfs:subClassOf cim-pt:StatusPoint ;
    rdfs:label "Fault Status"@en ; rdfs:label "故障状态"@zh-CN .

cim-pt:ModeStatus
    a owl:Class ; rdfs:subClassOf cim-pt:StatusPoint ;
    rdfs:label "Mode Status"@en ; rdfs:label "运行模式状态"@zh-CN .

cim-pt:AlarmStatus
    a owl:Class ; rdfs:subClassOf cim-pt:StatusPoint ;
    rdfs:label "Alarm Status"@en ; rdfs:label "报警状态"@zh-CN .

cim-pt:ValvePositionStatus
    a owl:Class ; rdfs:subClassOf cim-pt:StatusPoint ;
    rdfs:label "Valve Position Status"@en ; rdfs:label "阀门位置反馈"@zh-CN .

# ── 参数点 (Parameter Points) ────────────────────────────────────────────────
cim-pt:ParameterPoint
    a owl:Class ;
    rdfs:subClassOf cim-pt:Point ;
    rdfs:label "Parameter Point"@en ; rdfs:label "参数点（设计/运行参数）"@zh-CN ;
    skos:note "Brick: brick:Parameter"@en .

cim-pt:DesignParameter
    a owl:Class ; rdfs:subClassOf cim-pt:ParameterPoint ;
    rdfs:label "Design Parameter"@en ; rdfs:label "设计参数"@zh-CN .

cim-pt:OperatingParameter
    a owl:Class ; rdfs:subClassOf cim-pt:ParameterPoint ;
    rdfs:label "Operating Parameter"@en ; rdfs:label "运行参数"@zh-CN .

# ── Point 关联属性 ───────────────────────────────────────────────────────────
cim-pt:hasPoint
    a owl:ObjectProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range cim-pt:Point ;
    rdfs:label "has point"@en ; rdfs:label "关联数据点"@zh-CN ;
    skos:note "Brick: brick:hasPoint"@en .

cim-pt:isPointOf
    a owl:ObjectProperty ;
    owl:inverseOf cim-pt:hasPoint ;
    rdfs:label "is point of"@en ; rdfs:label "属于"@zh-CN .

cim-pt:measurementUnit
    a owl:DatatypeProperty ;
    rdfs:domain cim-pt:Point ;
    rdfs:range xsd:string ;
    rdfs:label "measurement unit"@en ; rdfs:label "计量单位"@zh-CN ;
    skos:note "建议使用 QUDT unit URI，如 unit:DEG_C"@zh-CN .

cim-pt:sampleInterval_s
    a owl:DatatypeProperty ;
    rdfs:domain cim-pt:Point ;
    rdfs:range xsd:integer ;
    rdfs:label "sample interval (seconds)"@en ; rdfs:label "采样间隔（秒）"@zh-CN .

# =============================================================================
# PART D — 扩展设备分类 (Equipment Extensions)
# 补充 M1 缺失的子类，与 Brick/ASHRAE 223P 对齐
# =============================================================================

# ── 末端机组细化 (Terminal Units) ────────────────────────────────────────────
cim-equip:TerminalUnit
    a owl:Class ;
    rdfs:subClassOf cim-equip:Equipment ;
    rdfs:label "Terminal Unit"@en ; rdfs:label "末端机组"@zh-CN ;
