# ── 消防水流 ──────────────────────────────────────────────────────────────────
cim-flow:FireWaterFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:WaterFlow ;
    rdfs:label "Fire Water Flow"@en ; rdfs:label "消防水流"@zh-CN ;
    rdfs:comment "消火栓系统和自动喷淋系统中的消防供水流动"@zh-CN .

# =============================================================================
# F.2 — 能量流细分 (EnergyFlow Subtypes)
# =============================================================================

cim-flow:ThermalEnergyFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:EnergyFlow ;
    rdfs:label "Thermal Energy Flow"@en ; rdfs:label "热能流"@zh-CN ;
    rdfs:comment "以热量（kW/kJ）为载荷的能量传递，如蒸发器/冷凝器换热量"@zh-CN .

cim-flow:ElectricalEnergyFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:EnergyFlow ;
    rdfs:label "Electrical Energy Flow"@en ; rdfs:label "电能流"@zh-CN ;
    rdfs:comment "沿配电网路的电功率传输，方向从电源到负荷"@zh-CN ;
    cim-c:hasMedium cim-med:ElectricalMedium .

cim-flow:ACPowerFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:ElectricalEnergyFlow ;
    rdfs:label "AC Power Flow"@en ; rdfs:label "交流电流"@zh-CN ;
    cim-c:hasMedium cim-med:ACPower .

cim-flow:DCPowerFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:ElectricalEnergyFlow ;
    rdfs:label "DC Power Flow"@en ; rdfs:label "直流电流"@zh-CN ;
    cim-c:hasMedium cim-med:DCPower .

cim-flow:EmergencyPowerFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:ACPowerFlow ;
    rdfs:label "Emergency Power Flow"@en ; rdfs:label "应急电源流"@zh-CN ;
    rdfs:comment "来自 UPS/柴发的应急供电回路，医疗关键负荷专用"@zh-CN ;
    cim-c:hasMedium cim-med:EmergencyPower .

# =============================================================================
# F.3 — 信息流细分 (InformationFlow Subtypes)
# =============================================================================

cim-flow:ControlSignalFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:InformationFlow ;
    rdfs:label "Control Signal Flow"@en ; rdfs:label "控制信号流"@zh-CN ;
    rdfs:comment "BAS/DDC 控制器向执行机构发出的模拟或数字控制指令"@zh-CN .

cim-flow:SensorDataFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:InformationFlow ;
    rdfs:label "Sensor Data Flow"@en ; rdfs:label "传感数据流"@zh-CN ;
    rdfs:comment "传感器测量值向控制器或数据采集系统的上行传输"@zh-CN .

cim-flow:AlarmSignalFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:InformationFlow ;
    rdfs:label "Alarm Signal Flow"@en ; rdfs:label "报警信号流"@zh-CN ;
    rdfs:comment "告警/故障信号从现场传感器到报警主机的传输路径"@zh-CN .

cim-flow:BACnetFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:ControlSignalFlow ;
    rdfs:label "BACnet Flow"@en ; rdfs:label "BACnet 通信流"@zh-CN ;
    skos:note "协议: BACnet/IP (ANSI/ASHRAE 135)"@en .

cim-flow:ModbusFlow
    a owl:Class ;
    rdfs:subClassOf cim-flow:ControlSignalFlow ;
    rdfs:label "Modbus Flow"@en ; rdfs:label "Modbus 通信流"@zh-CN .

# =============================================================================
# F.4 — 流动模型属性 (Flow Model Properties)
# =============================================================================

# ── 与连接点的关联 ────────────────────────────────────────────────────────────
cim-flow:sourcePoint
    a owl:ObjectProperty ;
    rdfs:domain cim-flow:FlowPath ;
    rdfs:range cim-c:ConnectionPoint ;
    rdfs:label "source connection point"@en ; rdfs:label "流动起点"@zh-CN ;
    rdfs:comment "流动方向的上游连接点（Outlet of upstream equipment）"@zh-CN .

cim-flow:sinkPoint
    a owl:ObjectProperty ;
    rdfs:domain cim-flow:FlowPath ;
    rdfs:range cim-c:ConnectionPoint ;
    rdfs:label "sink connection point"@en ; rdfs:label "流动终点"@zh-CN ;
    rdfs:comment "流动方向的下游连接点（Inlet of downstream equipment）"@zh-CN .

# ── 介质关联（从 Part A/B 复用） ──────────────────────────────────────────────
cim-flow:carriesMedium
    a owl:ObjectProperty ;
    owl:equivalentProperty cim-c:hasMedium ;
    rdfs:domain cim-flow:FlowPath ;
    rdfs:range cim-med:Medium ;
    rdfs:label "carries medium"@en ; rdfs:label "携带介质"@zh-CN ;
    rdfs:comment "FlowPath 的首选介质属性（与 cim-c:hasMedium 等价，语义更明确）"@zh-CN .

# ── 流动路径穿越的构件 ────────────────────────────────────────────────────────
cim-flow:flowsThrough
    a owl:ObjectProperty ;
    rdfs:domain cim-flow:FlowPath ;
    rdfs:range cim-equip:Equipment ;
    rdfs:label "flows through"@en ; rdfs:label "流经"@zh-CN ;
    rdfs:comment "流动路径经过的管段/构件/设备（允许多跳）"@zh-CN .

# ── 流向 ─────────────────────────────────────────────────────────────────────
cim-flow:flowDirection
    a owl:DatatypeProperty ;
    rdfs:domain cim-flow:FlowPath ;
    rdfs:range xsd:string ;
    rdfs:label "flow direction"@en ; rdfs:label "流向"@zh-CN ;
    skos:note "取值: supply / return / exhaust / discharge / bidirectional"@en .

# ── 设计流量 ──────────────────────────────────────────────────────────────────
cim-flow:designFlowRate
    a owl:DatatypeProperty ;
    rdfs:domain cim-flow:MassFlow ;
    rdfs:range xsd:decimal ;
    rdfs:label "design flow rate"@en ; rdfs:label "设计流量"@zh-CN ;
    rdfs:comment "单位依介质类型: 空气 m³/h, 水 m³/h 或 L/s, 气体 L/min"@zh-CN .

cim-flow:designFlowRateUnit
    a owl:DatatypeProperty ;
    rdfs:domain cim-flow:MassFlow ;
    rdfs:range xsd:string ;
    rdfs:label "design flow rate unit"@en ; rdfs:label "设计流量单位"@zh-CN .

cim-flow:designPower
    a owl:DatatypeProperty ;
    rdfs:domain cim-flow:EnergyFlow ;
    rdfs:range xsd:decimal ;
    rdfs:label "design power (kW)"@en ; rdfs:label "设计功率（kW）"@zh-CN .

# ── 载体类型/荷载类型（M1 保留兼容） ─────────────────────────────────────────
cim-flow:carrierType
    a owl:DatatypeProperty ;
    rdfs:domain cim-flow:FlowPath ;
    rdfs:range xsd:string ;
    rdfs:label "carrier type"@en ; rdfs:label "载体类型"@zh-CN ;
    rdfs:comment "物理载体描述，如: duct / pipe / wire / wireless / gravity"@zh-CN .

cim-flow:payloadType
    a owl:DatatypeProperty ;
    rdfs:domain cim-flow:FlowPath ;
    rdfs:range xsd:string ;
    rdfs:label "payload type"@en ; rdfs:label "荷载类型"@zh-CN ;
    rdfs:comment "传输的实质内容类型，如: chilled-water / exhaust-air / BACnet-data"@zh-CN .

# ── 测量关联 ──────────────────────────────────────────────────────────────────
cim-flow:measuredBy
    a owl:ObjectProperty ;
    rdfs:domain cim-flow:FlowPath ;
    rdfs:range cim-ctrl:Sensor ;
    rdfs:label "measured by"@en ; rdfs:label "由...测量"@zh-CN ;
    rdfs:comment "关联到监测该流路参数的传感器（流量计/能量表等）"@zh-CN .

# =============================================================================
# F.5 — 流动系统关联 (Flow-System Linkage)
# FlowPath 归属于系统，系统为设备服务
# =============================================================================

cim-flow:belongsToSystem
    a owl:ObjectProperty ;
    rdfs:domain cim-flow:FlowPath ;
    rdfs:range cim:System ;
    rdfs:label "belongs to system"@en ; rdfs:label "归属系统"@zh-CN ;
    rdfs:comment "将流路关联到其所在的建筑技术系统（如冷冻水系统、送风系统）"@zh-CN .

cim-flow:hasFlowPath
    a owl:ObjectProperty ;
    owl:inverseOf cim-flow:belongsToSystem ;
    rdfs:domain cim:System ;
    rdfs:range cim-flow:FlowPath ;
    rdfs:label "has flow path"@en ; rdfs:label "包含流路"@zh-CN .

# =============================================================================
# END OF LAYER 1 CONCEPTUAL ONTOLOGY
# =============================================================================
