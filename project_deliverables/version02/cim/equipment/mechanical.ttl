@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@prefix cim:        <https://cim.medical/ontology/v3.4#> .
@prefix cim-equip:  <https://cim.medical/ontology/v3.4/equipment#> .

<https://cim.medical/ontology/v3.4/equipment/mechanical>
    a owl:Ontology ;
    rdfs:label "CIM HVAC Equipment Module"@en ;
    rdfs:comment "HVAC and air handling equipment for building systems."@en ;
    owl:versionInfo "2.0.0-Final" ;
    owl:imports <https://cim.medical/ontology/v3.4/topology/node_types> ;
    owl:imports <https://cim.medical/ontology/v3.4/equipment/equipment_hierarchy> .

cim-equip:Chiller
    a owl:Class ;
    rdfs:subClassOf cim-equip:Equipment ;
    rdfs:label "Chiller"@en ;
    rdfs:label "冷水机组"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    skos:note "离心式或螺杆式冷水机组，用于空调系统制冷"@zh-CN .

cim-equip:AHU
    a owl:Class ;
    rdfs:subClassOf cim-equip:Equipment ;
    rdfs:label "Air Handling Unit"@en ;
    rdfs:label "空调机组"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    skos:note "组合式空调机组，包含风机、盘管、过滤器等"@zh-CN .

cim-equip:Clean_AHU
    a owl:Class ;
    rdfs:subClassOf cim-equip:AHU ;
    rdfs:label "Clean Air Handling Unit"@en ;
    rdfs:label "洁净空调机组"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    skos:note "用于洁净室和手术室的专用净化空调机组"@zh-CN .

cim-equip:HEPA_Filter
    a owl:Class ;
    rdfs:subClassOf cim-equip:Component ;
    rdfs:label "HEPA Filter"@en ;
    rdfs:label "HEPA高效过滤器"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    skos:note "高效空气过滤器，用于洁净空间和手术室"@zh-CN ;
    cim:reliabilityLevel "LIFE_SAFETY"^^xsd:string .

cim-equip:CoolingTower
    a owl:Class ;
    rdfs:subClassOf cim-equip:Equipment ;
    rdfs:label "Cooling Tower"@en ;
    rdfs:label "冷却塔"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    skos:note "用于冷却水系统散热"@zh-CN .

cim-equip:Pump
    a owl:Class ;
    rdfs:subClassOf cim-equip:Equipment ;
    rdfs:label "Pump"@en ;
    rdfs:label "水泵"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    skos:note "冷冻/冷却/热水循环泵"@zh-CN .

cim-equip:VAV_Terminal
    a owl:Class ;
    rdfs:subClassOf cim-equip:Equipment ;
    rdfs:label "VAV Terminal"@en ;
    rdfs:label "VAV末端"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    skos:note "变风量末端装置，用于空调分区控制"@zh-CN .

cim-equip:FCU
    a owl:Class ;
    rdfs:subClassOf cim-equip:Equipment ;
    rdfs:label "Fan Coil Unit"@en ;
    rdfs:label "风机盘管"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    skos:note "风机盘管机组，通常用于房间级空调"@zh-CN .

cim-equip:Fan
    a owl:Class ;
    rdfs:subClassOf cim-equip:Equipment ;
    rdfs:label "Fan"@en ;
    rdfs:label "风机"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    skos:note "送风机/排风机，含轴流风机和离心风机"@zh-CN .

cim-equip:SupplyFan
    a owl:Class ;
    rdfs:subClassOf cim-equip:Fan ;
    rdfs:label "Supply Fan"@en ;
    rdfs:label "送风机"@zh-CN ;
    skos:note "AHU 内置或独立送风机，对应 brk:Supply_Fan"@zh-CN .

cim-equip:ReturnFan
    a owl:Class ;
    rdfs:subClassOf cim-equip:Fan ;
    rdfs:label "Return Fan"@en ;
    rdfs:label "回风机"@zh-CN ;
    skos:note "回风系统风机，维持回风量与送风量平衡"@zh-CN .

cim-equip:ExhaustFan
    a owl:Class ;
    rdfs:subClassOf cim-equip:Fan ;
    rdfs:label "Exhaust Fan"@en ;
    rdfs:label "排风机"@zh-CN ;
    skos:note "排风系统风机，含屋顶排风机和管道排风机"@zh-CN .

cim-equip:Boiler
    a owl:Class ;
    rdfs:subClassOf cim-equip:Equipment ;
    rdfs:label "Boiler"@en ;
    rdfs:label "锅炉/热水机组"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    skos:note "燃气锅炉或电热水机组，用于热水供暖系统"@zh-CN .

cim-equip:HeatExchanger
    a owl:Class ;
    rdfs:subClassOf cim-equip:Equipment ;
    rdfs:label "Heat Exchanger"@en ;
    rdfs:label "换热器"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    skos:note "板式或管式换热器，用于冷/热源侧热交换"@zh-CN .

# ── 医用气体设备 ────────────────────────────────────────────────────────────

cim-equip:MedicalGasOutlet
    a owl:Class ;
    rdfs:subClassOf cim-equip:Equipment ;
    rdfs:label "Medical Gas Outlet"@en ;
    rdfs:label "医用气体末端接口"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    cim:topologyRole "SINK"^^xsd:string ;
    cim:reliabilityLevel "LIFE_SAFETY"^^xsd:string ;
    skos:note "手术室/ICU床头医用气体终端（氧气、负压、压缩空气接口）"@zh-CN .

cim-equip:MedGasCompressor
    a owl:Class ;
    rdfs:subClassOf cim-equip:Equipment ;
    rdfs:label "Medical Gas Compressor"@en ;
    rdfs:label "医用气体压缩机"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    cim:topologyRole "SRC"^^xsd:string ;
    skos:note "医用压缩空气机组，输出压力 0.4-0.8 MPa"@zh-CN .

cim-equip:LiquidOxygenStation
    a owl:Class ;
    rdfs:subClassOf cim-equip:Equipment ;
    rdfs:label "Liquid Oxygen Station"@en ;
    rdfs:label "液氧站"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    cim:topologyRole "SRC"^^xsd:string ;
    cim:reliabilityLevel "LIFE_SAFETY"^^xsd:string ;
    skos:note "低温液氧储罐及汽化设备，为全院供氧"@zh-CN .

cim-equip:VacuumPumpUnit
    a owl:Class ;
    rdfs:subClassOf cim-equip:Equipment ;
    rdfs:label "Vacuum Pump Unit"@en ;
    rdfs:label "真空泵机组"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    cim:topologyRole "SRC"^^xsd:string ;
    skos:note "医用负压中心机组，产生 -0.04 MPa 负压"@zh-CN .

# ── 管网分布元件 ────────────────────────────────────────────────────────────

cim-equip:Pipe
    a owl:Class ;
    rdfs:subClassOf cim-equip:DistributionComponent ;
    rdfs:label "Pipe"@en ;
    rdfs:label "管道"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    cim:topologyRole "DIST"^^xsd:string ;
    skos:note "对应 IFC IfcFlowSegment"@zh-CN .

cim-equip:PipeFitting
    a owl:Class ;
    rdfs:subClassOf cim-equip:DistributionComponent ;
    rdfs:label "Pipe Fitting"@en ;
    rdfs:label "管件"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    cim:topologyRole "DIST"^^xsd:string ;
    skos:note "弯头、三通、异径管等，对应 IFC IfcFlowFitting"@zh-CN .

cim-equip:FlowControlValve
    a owl:Class ;
    rdfs:subClassOf cim-equip:Equipment ;
    rdfs:label "Flow Control Valve"@en ;
    rdfs:label "控制阀"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    skos:note "电动调节阀、电磁阀等，对应 IFC IfcFlowController"@zh-CN .

cim-equip:DistributionComponent
    a owl:Class ;
    rdfs:subClassOf cim-equip:Equipment ;
    rdfs:label "Distribution Component"@en ;
    rdfs:label "分配网络元件"@zh-CN ;
    cim:sourceAgent "Agent-03" ;
    rdfs:comment "管道、管件等分配网络的基础元件（非独立设备）"@zh-CN .

# ============================================================================
# END OF HVAC EQUIPMENT MODULE
# ============================================================================
