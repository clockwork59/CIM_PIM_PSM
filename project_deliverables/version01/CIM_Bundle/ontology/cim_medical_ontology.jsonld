    {"@id": "cim:GasMeter", "@type": "rdfs:Class", "rdfs:subClassOf": "cim:Sensor", "rdfs:label": "气表"},

    {"@id": "cim:System", "@type": "rdfs:Class", "rdfs:subClassOf": "brick:System", "rdfs:label": "系统", "rdfs:comment": "由多个设备组成的功能系统"},
