    {"@id": "cim:PM25Sensor", "@type": "rdfs:Class", "rdfs:subClassOf": "cim:Sensor", "rdfs:label": "PM2.5传感器"},
    {"@id": "cim:OccupancySensor", "@type": "rdfs:Class", "rdfs:subClassOf": "cim:Sensor", "rdfs:label": "人员存在传感器"},
